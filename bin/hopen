#!/usr/bin/env bash
# hopen opens all the projects of a list in one named Herdr session, with one
# Herdr workspace for each folder, and then attaches to it. A list is a VS Code
# workspace file or a herdspace.toml file. docs/hopen.md explains both.
#
# Run it again at any time. It starts a stopped session, adds only the folders
# that have no workspace, and closes nothing. The first workspace has the name
# of the session and opens the folder that holds the list file.
#
# A template splits a new workspace into named panes and starts a program in
# each. After a stopped session starts again, hopen starts those programs again.
#
# Usage: hopen <session> [--template NAME] [--file PATH] [--no-attach] [--trust]
#        hopen                   In a terminal, choose a list from a menu.
#        hopen <folder>          Open a folder, for example "hopen .". A list in
#                                the folder wins. Else one workspace, no list.
#        hopen --all [session] [--template NAME]
#        hopen --list            Show every list and its state.
#        hopen --templates       Show every template.
#        hopen --apply NAME      Split the current tab with a template.
#        hopen --convert NAME    Write ~/NAME/herdspace.toml from the VS Code list NAME.
#        hopen --completion zsh|bash   Print a shell completion script.
#        hopen --task [NAME]     Run a task of the project of the current folder.
#        hopen --find            Choose a file with fzf, and open it in the editor.
#        hopen --quick-open      Choose a file of the project, and open it in the editor
#                                of the tab, with the focus on it (Cmd+P in Herdr).
#        hopen --grep TEXT       Search the files, and open a result at its line.
#        hopen --ports           Show the TCP ports that your programs listen on.
#        hopen --palette         Choose an action from a menu, like the command
#                                palette of VS Code. Cmd+Shift+P opens it in Herdr.
#
# A list can run commands (on-open and tab commands) and set environment
# values. hopen asks before it uses them the first time, and again after the
# list changes. With no terminal, it uses them only with --trust.
set -euo pipefail

# The release script writes the release tag here.
HOPEN_VERSION="dev"
SESSION=""
LIST_FILE=""
ATTACH=1
ACTION="one"
TEMPLATE_FLAG=""
APPLY_NAME=""
SHELL_NAME=""
COMPLETE_WHAT=""
TEMPLATE_DIR="${HOPEN_TEMPLATES:-${XDG_CONFIG_HOME:-$HOME/.config}/hopen/templates}"
STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/hopen"
STARTED=0
# GUARD_PAIRS holds one "pane id<TAB>name" line for each pane that a template named.
GUARD_PAIRS=""
# GUARD_TABS holds one "root pane id<TAB>name" line for each tab that a list named.
GUARD_TABS=""
# ENV_ARGS holds one "--env KEY=VALUE" pair for each environment value of the
# project that hopen opens now. Each new workspace, tab, and pane gets them.
ENV_ARGS=()
TRUST_FLAG=0
TASK_NAME=""
GREP_TEXT=""
# FOLDER is set for "hopen <folder>" when the folder has no list of its own.
FOLDER=""

usage() {
  echo "Usage: hopen <session> [--template NAME] [--file PATH] [--no-attach] [--trust]"
  echo "       hopen            (in a terminal: choose a list from a menu)"
  echo "       hopen <folder>   (for example: hopen .)"
  echo "       hopen --all [session] [--template NAME]"
  echo "       hopen --list"
  echo "       hopen --templates"
  echo "       hopen --apply NAME"
  echo "       hopen --convert NAME"
  echo "       hopen --completion zsh|bash"
  echo "       hopen --task [NAME]"
  echo "       hopen --find"
  echo "       hopen --quick-open"
  echo "       hopen --grep TEXT"
  echo "       hopen --ports"
  echo "       hopen --palette"
  echo "       hopen --version"
}
# short_path PATH shows a path in the home folder as ~/... The ~ is in a
# variable, because bash 5 expands a ~ in the replacement text.
short_path() { local tilde='~'; printf '%s' "${1/#$HOME/$tilde}"; }
warn() { printf '  [warn] %s\n' "$*" >&2; }
die() { printf '  [err]  %s\n' "$*" >&2; exit 1; }

while [ "$#" -gt 0 ]; do
  case "$1" in
    --file | --template | --apply | --convert | --completion | --complete)
      [ "$#" -ge 2 ] || { usage >&2; exit 2; }
      case "$1" in
        --file) LIST_FILE="$2" ;;
        --template) TEMPLATE_FLAG="$2" ;;
        --apply) ACTION="apply"; APPLY_NAME="$2" ;;
        --convert) ACTION="convert"; SESSION="$2" ;;
        --completion) ACTION="completion"; SHELL_NAME="$2" ;;
        --complete) ACTION="complete"; COMPLETE_WHAT="$2" ;;
      esac
      shift 2
      ;;
    --task)
      ACTION="task"
      shift
      if [ "$#" -gt 0 ] && [ "${1#-}" = "$1" ]; then
        TASK_NAME="$1"
        shift
      fi
      ;;
    --find) ACTION="find"; shift ;;
    --quick-open) ACTION="quick"; shift ;;
    --ports) ACTION="ports"; shift ;;
    --palette) ACTION="palette"; shift ;;
    --print) PALETTE_PRINT=1; shift ;;
    --grep)
      [ "$#" -ge 2 ] || { usage >&2; exit 2; }
      ACTION="grep"; GREP_TEXT="$2"; shift 2
      ;;
    --no-attach) ATTACH=0; shift ;;
    --trust) TRUST_FLAG=1; shift ;;
    --all) ACTION="all"; shift ;;
    --list) ACTION="list"; shift ;;
    --templates) ACTION="templates"; shift ;;
    --version) echo "hopen ${HOPEN_VERSION}"; exit 0 ;;
    -h | --help) usage; exit 0 ;;
    -*) usage >&2; exit 2 ;;
    *)
      [ -z "$SESSION" ] || { usage >&2; exit 2; }
      SESSION="$1"
      shift
      ;;
  esac
done

# no_list_error NAME stops with a message for a name that has no list. It shows
# the lists that exist, the closest one for a typo, and how to make the list.
no_list_error() {
  local name="$1" names close
  names="$(find_lists 2>/dev/null | cut -f1 | sort -u)"
  {
    printf '  [err]  No list of projects named %s.\n' "$name"
    if [ -n "$names" ]; then
      printf '         Your lists: %s\n' "$(printf '%s\n' "$names" | paste -sd ',' - | sed 's/,/, /g')"
      close="$(printf '%s\n' "$names" | python3 -I -c '
import difflib, sys
names = sys.stdin.read().split()
match = difflib.get_close_matches(sys.argv[1], names, n=1, cutoff=0.6)
print(match[0] if match else "")
' "$name")"
      [ -z "$close" ] || printf '         Did you mean: %s?\n' "$close"
    else
      printf '         You have no list yet.\n'
    fi
    printf '         To create the list %s, write ~/%s/herdspace.toml, for example:\n' "$name" "$name"
    printf '           [[project]]\n           name = "api"\n           path = "~/code/api"\n'
    printf '         To open one folder with no list, run: hopen ~/code/api\n'
  } >&2
  exit 1
}

valid_name() {
  case "$1" in
    "" | *[!A-Za-z0-9._-]*) return 1 ;;
    *) return 0 ;;
  esac
}

# ---------- shell completion

# completion_script SHELL prints a completion script for zsh or bash. It asks
# "hopen --complete lists|templates" for the names, so that they stay current.
completion_script() {
  case "$1" in
    zsh)
      cat <<'ZSH'
#compdef hopen
_hopen() {
  local -a options
  options=(--all --list --templates --apply --convert --file --template --no-attach --trust --task --find --quick-open --grep --ports --palette --completion --version --help)
  case "${words[CURRENT-1]}" in
    --template | --apply) compadd -- ${(f)"$(hopen --complete templates 2>/dev/null)"}; return ;;
    --convert) compadd -- ${(f)"$(hopen --complete lists 2>/dev/null)"}; return ;;
    --task) compadd -- ${(f)"$(hopen --complete tasks 2>/dev/null)"}; return ;;
    --file) _files; return ;;
    --completion) compadd zsh bash; return ;;
  esac
  case "$PREFIX" in
    -*) compadd -- $options ;;
    */* | .*) _files -/ ;;
    *) compadd -- ${(f)"$(hopen --complete lists 2>/dev/null)"} ;;
  esac
}
compdef _hopen hopen
ZSH
      ;;
    bash)
      cat <<'BASH'
# This works with bash 3.2, the bash of macOS, which has no mapfile.
_hopen() {
  local cur="${COMP_WORDS[COMP_CWORD]}" prev="${COMP_WORDS[COMP_CWORD-1]}" words="" IFS=$'\n'
  case "$prev" in
    --template | --apply) words="$(hopen --complete templates 2>/dev/null)" ;;
    --convert) words="$(hopen --complete lists 2>/dev/null)" ;;
    --task) words="$(hopen --complete tasks 2>/dev/null)" ;;
    --completion) words=$'zsh\nbash' ;;
    --file) COMPREPLY=($(compgen -f -- "$cur")); return ;;
    *)
      case "$cur" in
        -*) words=$'--all\n--list\n--templates\n--apply\n--convert\n--file\n--template\n--no-attach\n--trust\n--task\n--find\n--quick-open\n--grep\n--ports\n--palette\n--completion\n--version\n--help' ;;
        */* | .*) COMPREPLY=($(compgen -d -- "$cur")); return ;;
        *) words="$(hopen --complete lists 2>/dev/null)" ;;
      esac
      ;;
  esac
  COMPREPLY=($(compgen -W "$words" -- "$cur"))
}
complete -o filenames -F _hopen hopen
BASH
      ;;
    *) die "hopen --completion needs zsh or bash." ;;
  esac
}

# ---------- templates

template_file() { printf '%s/%s.layout' "$TEMPLATE_DIR" "$1"; }

# template_exists exits 0 for a template file, and for "plain", which means no
# panes. A name is letters, numbers, "-", and "_", so it cannot leave the folder.
template_exists() {
  [ "$1" = plain ] && return 0
  [[ "$1" =~ ^[A-Za-z0-9][A-Za-z0-9_-]*$ ]] || return 1
  [ -f "$(template_file "$1")" ]
}

template_lines() { grep -vE '^[[:space:]]*(#|$)' "$(template_file "$1")"; }

show_templates() {
  local file name text
  printf '%-12s %s\n' TEMPLATE DESCRIPTION
  printf '%-12s %s\n' plain "One pane with a shell. This is the default."
  for file in "$TEMPLATE_DIR"/*.layout; do
    [ -f "$file" ] || continue
    name="$(basename "$file" .layout)"
    text="$(sed -n "1s/^# *${name}: *//p" "$file")"
    printf '%-12s %s\n' "$name" "${text:-}"
  done
}

json_get() { python3 -I -c "import json,sys; d=json.load(sys.stdin); print(eval(sys.argv[1], {'d': d}))" "$1"; }

# apply_template NAME ROOT_PANE splits from ROOT_PANE and starts each program.
apply_template() {
  local name="$1" root="$2" made pane from direction size command id source
  made="$(printf '%s\t%s' "" "")"
  while read -r pane from direction size command; do
    if [ "$from" = "-" ]; then
      id="$root"
    else
      source="$(awk -F '\t' -v n="$from" '$1 == n {print $2}' <<<"$made")"
      if [ -z "$source" ]; then
        warn "Template ${name}: the pane ${from} comes later or does not exist."
        continue
      fi
      id="$(herdr pane split "$source" --direction "$direction" --ratio "$size" --no-focus ${ENV_ARGS[@]+"${ENV_ARGS[@]}"} | json_get "d['result']['pane']['pane_id']")"
    fi
    herdr pane rename "$id" "$pane" >/dev/null
    GUARD_PAIRS="${GUARD_PAIRS}${id}"$'\t'"${pane}"$'\n'
    made="${made}
$(printf '%s\t%s' "$pane" "$id")"
    if [ -n "$command" ] && [ "$command" != "-" ]; then
      herdr pane run "$id" "$command" >/dev/null
    fi
  done < <(template_lines "$name")
}

# guard_names keeps the template pane names and the tab names of a list for a
# short time. A plugin such as Auto Title names panes and tabs too. It keeps a name that you chose, but after a
# restart it can forget that choice, because every session writes its choices
# to one shared file, with pane IDs that repeat across sessions. So for
# HOPEN_GUARD_SECONDS (default 30), a background job puts back each template
# name that changed. The plugin then counts the name as one that you chose
# again. HOPEN_GUARD_SECONDS=0 turns the guard off.
guard_names() {
  local seconds="${HOPEN_GUARD_SECONDS:-30}"
  [ -n "$GUARD_PAIRS$GUARD_TABS" ] && [ "$seconds" != 0 ] || return 0
  printf '%s\036%s' "$GUARD_PAIRS" "$GUARD_TABS" | nohup python3 -I -c '
import json, subprocess, sys, time
panes_text, _, tabs_text = sys.stdin.read().partition("\x1e")
pairs = [line.split("\t", 1) for line in panes_text.split("\n") if "\t" in line]
# A tab is found by its first pane, because a tab create answer has that pane.
tabs = [line.split("\t", 1) for line in tabs_text.split("\n") if "\t" in line]
end = time.time() + float(sys.argv[1])

def herdr(*args):
    out = subprocess.run(["herdr", *args], capture_output=True, text=True, timeout=5).stdout
    return json.loads(out)["result"]

while (pairs or tabs) and time.time() < end:
    time.sleep(0.5)
    try:
        panes = herdr("pane", "list")["panes"]
        labels = {p["pane_id"]: p.get("label") or "" for p in panes}
        tab_of = {p["pane_id"]: (p["workspace_id"], p["tab_id"]) for p in panes}
        tab_labels = {}
        for workspace in {tab_of[pane][0] for pane, _ in tabs if pane in tab_of}:
            for tab in herdr("tab", "list", "--workspace", workspace)["tabs"]:
                tab_labels[tab["tab_id"]] = tab.get("label") or ""
    except Exception:
        continue
    pairs = [(pane, name) for pane, name in pairs if pane in labels]
    for pane, name in pairs:
        if labels[pane] != name:
            subprocess.run(["herdr", "pane", "rename", pane, name], capture_output=True, timeout=5)
    tabs = [(pane, name) for pane, name in tabs if pane in tab_of and tab_of[pane][1] in tab_labels]
    for pane, name in tabs:
        tab = tab_of[pane][1]
        if tab_labels[tab] != name:
            subprocess.run(["herdr", "tab", "rename", tab, name], capture_output=True, timeout=5)
' "$seconds" >/dev/null 2>&1 &
  disown
  GUARD_PAIRS=""
  GUARD_TABS=""
}

# ---------- project lists

# A list is a VS Code workspace file, ~/<name>.code-workspace or
# ~/<name>/<name>.code-workspace, or a herdspace file, ~/<name>/herdspace.toml.
# The session has the name of the file or the folder, unless the list sets one.

# read_list FILE WHAT prints facts about one list. WHAT is one of:
#   session  the session name
#   items    one line for each workspace and each extra tab. The fields are
#            separated by the byte 0x1e (RS below), which is not white space,
#            so that bash keeps each field in its place:
#            R RS label RS path RS template RS on_open RS env   (the parent workspace)
#            P RS label RS path RS template RS on_open RS env   (a project)
#            T RS label RS tab name RS template RS command
#            F RS label RS file RS names RS env  (the values of an env file;
#                                                 it comes before its R or P line)
#            K RS label RS task name RS command   (a task; it comes after its R or P line)
#            W RS message                                       (a warning)
#            env is KEY=VALUE items, separated by the byte 0x1f. An empty
#            field is "-". No field holds a control character.
# list_python FILE prints the Python that reads FILE. A herdspace.toml list
# needs tomllib, which is in Python 3.11 and later. Some systems have an older
# python3 and a newer python3.N beside it, for example Ubuntu 22.04.
list_python() {
  local py
  if [ "$(basename "$1")" = herdspace.toml ]; then
    for py in python3 python3.14 python3.13 python3.12 python3.11; do
      command -v "$py" >/dev/null 2>&1 || continue
      "$py" -I -c 'import sys; sys.exit(sys.version_info < (3, 11))' 2>/dev/null && { echo "$py"; return 0; }
    done
  fi
  echo python3
}

read_list() {
  "$(list_python "$1")" -I - "$1" "$2" "${TEMPLATE_FLAG:-}" <<'PY'
import json, os, re, sys, unicodedata

path, what, forced = sys.argv[1:4]
path = os.path.abspath(path)
base = os.path.dirname(path)


# Unicode categories that a list must not show or pass on: control characters
# (for example ESC), format characters (for example bidi marks that reorder
# text), and line or paragraph separators.
HIDDEN = ("Cc", "Cf", "Zl", "Zp", "Cs", "Co")

def has_hidden(value):
    return any(unicodedata.category(c) in HIDDEN for c in str(value))

def clean(value):
    # Tabs and new lines become spaces. Every other hidden character becomes
    # "?", so that a list cannot add a line or change what the approval
    # question shows.
    text = str(value).replace("\t", " ").replace("\n", " ").replace("\r", " ")
    return "".join("?" if unicodedata.category(c) in HIDDEN else c for c in text).strip()

def emit(kind, *fields, env=None):
    # Each output line goes through here, so each field is clean, and an
    # empty field is "-". The environment values are a list of clean
    # KEY=VALUE items.
    parts = [kind] + [clean(value) or "-" for value in fields]
    if env is not None:
        parts.append("\x1f".join(env) if env else "-")
    print("\x1e".join(parts))

def warn(text):
    emit("W", text)

if has_hidden(base):
    sys.exit("The folder of the list has a control character in its name.")

TEMPLATE_NAME = re.compile(r"[A-Za-z0-9][A-Za-z0-9_-]*")

def template_name(value, where):
    # A template is a file in the templates folder of the person. A name with
    # "/" or ".." could point at a file from somewhere else, so it is refused.
    if value is None or value == "":
        return None
    if not isinstance(value, str) or not TEMPLATE_NAME.fullmatch(value):
        warn(f"{where}: the template name {clean(value)} is not valid. hopen uses the default.")
        return None
    return value

def field(value):
    return clean(value) or "-"

def list_path(raw):
    # A path with a hidden character could break the output lines.
    if has_hidden(raw):
        return None
    return os.path.normpath(os.path.join(base, os.path.expanduser(str(raw))))

if os.path.basename(path) == "herdspace.toml":
    if sys.version_info < (3, 11):
        how = "brew install python" if sys.platform == "darwin" else "sudo apt-get install python3.11, or with no sudo, uv python install 3.12"
        sys.exit("herdspace.toml needs Python 3.11 or later. Install one, for example with: " + how + ". A VS Code workspace file works with an older Python.")
    import tomllib
    with open(path, "rb") as handle:
        try:
            data = tomllib.load(handle)
        except tomllib.TOMLDecodeError as error:
            sys.exit(f"{path}: {error}")
    session = data.get("session") or os.path.basename(base)
    default = data.get("template", "plain")
    parent = data.get("parent_workspace", True)
    projects = []
    for entry in data.get("project", []):
        if not isinstance(entry, dict) or "path" not in entry:
            warn("A [[project]] entry has no path, so hopen skips it.")
            continue
        projects.append({
            "path": entry["path"],
            "name": entry.get("name"),
            "template": entry.get("template"),
            "on_open": entry.get("on_open", ""),
            "tabs": entry.get("tabs", []),
            "env": entry.get("env", {}),
            "env_file": entry.get("env_file"),
            "tasks": entry.get("tasks", {}),
        })
    parent_open = data.get("on_open", "")
    parent_tasks = data.get("tasks", {})
    parent_env = data.get("env", {})
    parent_env_file = data.get("env_file")
    parent_template = data.get("parent_template")
else:
    with open(path, encoding="utf-8") as handle:
        text = handle.read()
    # VS Code accepts comment lines and trailing commas.
    text = re.sub(r"^\s*//.*$", "", text, flags=re.M)
    text = re.sub(r",(\s*[\]}])", r"\1", text)
    try:
        data = json.loads(text)
    except ValueError as error:
        sys.exit(f"{path}: {error}")
    settings = data.get("settings", {}) or {}
    session = settings.get("hopen.session") or os.path.basename(path)[: -len(".code-workspace")]
    default = settings.get("hopen.template", "plain")
    parent = settings.get("hopen.parentWorkspace", True)
    per_template = settings.get("hopen.templates", {}) or {}
    per_open = settings.get("hopen.onOpen", {}) or {}
    per_tabs = settings.get("hopen.tabs", {}) or {}
    per_env = settings.get("hopen.env", {}) or {}
    per_env_file = settings.get("hopen.envFile", {}) or {}
    per_tasks = settings.get("hopen.tasks", {}) or {}
    projects = []
    for folder in data.get("folders", []):
        if not isinstance(folder, dict) or "path" not in folder:
            warn("A folder entry has no path, so hopen skips it.")
            continue
        full = os.path.normpath(os.path.join(base, os.path.expanduser(folder["path"])))
        label = folder.get("name") or os.path.basename(full)
        projects.append({
            "path": folder["path"],
            "name": label,
            "template": per_template.get(label),
            "on_open": per_open.get(label, ""),
            "tabs": per_tabs.get(label, []),
            "env": per_env.get(label, {}),
            "env_file": per_env_file.get(label),
            "tasks": per_tasks.get(label, {}),
        })
    parent_tasks = per_tasks.get(session, {})
    parent_open = per_open.get(session, "")
    parent_env = per_env.get(session, {})
    parent_env_file = per_env_file.get(session)
    parent_template = per_template.get(session)

if not isinstance(parent, bool):
    warn("The parent workspace setting must be true or false. hopen uses true.")
    parent = True

if what == "session":
    if not clean(session):
        sys.exit("The session name of the list is empty.")
    print(clean(session))
    sys.exit(0)

default = template_name(default, "template") or "plain"

def template(value, where=""):
    return forced or template_name(value, where or "template") or default

def env_items(label, values):
    if not values:
        return []
    if not isinstance(values, dict):
        warn(f"{label}: env must be a map of names to values. hopen skips it.")
        return []
    items = []
    for key, value in values.items():
        if not re.fullmatch(r"[A-Za-z_][A-Za-z0-9_]*", str(key)) or isinstance(value, (dict, list)):
            warn(f"{label}: the environment value {key} is not valid. hopen skips it.")
            continue
        if isinstance(value, bool):
            value = "true" if value else "false"
        items.append(f"{key}={clean(value)}")
    return items

ENV_NAME = re.compile(r"[A-Za-z_][A-Za-z0-9_]*")

# An env file cannot set a name that makes a shell or a program run code.
# The approval question shows each other value, but it hides a value whose
# name looks like a secret.
RISKY = re.compile(r"PATH|HOME|SHELL|ENV|BASH_ENV|ZDOTDIR|PROMPT_COMMAND|PS[0-4]|IFS|TERM|TMPDIR"
                   r"|LD_.*|DYLD_.*|NODE_.*|NPM_CONFIG_.*|PYTHON.*|PERL.*|RUBY.*|GEM_.*|JAVA_.*|_JAVA_.*"
                   r"|GIT_.*|SSH_.*|XDG_.*|LESS.*|.*_COMMAND|.*_OPTIONS|.*_OPTS|.*PAGER|.*ASKPASS|.*EDITOR"
                   r"|VISUAL|BROWSER|HERDR_.*|HOPEN_.*", re.I)
SECRET = re.compile(r".*(TOKEN|SECRET|PASSWORD|PASSWD|PASS|PWD|KEY|CREDENTIAL|AUTH|PRIVATE|SESSION|COOKIE|DSN).*", re.I)

def env_file(label, raw, folder):
    # env_file reads a .env file: KEY=VALUE lines, with "#" comments, an
    # optional "export ", and optional quotes. A relative path starts at the
    # folder of the project. It emits one F line before the R or P line.
    if raw is None or raw == "":
        return
    if not isinstance(raw, str) or has_hidden(raw):
        warn(f"{label}: env_file must be a path. hopen skips it.")
        return
    file = os.path.normpath(os.path.join(folder, os.path.expanduser(raw)))
    try:
        with open(file, encoding="utf-8") as handle:
            lines = handle.read().split("\n")
    except (OSError, UnicodeDecodeError):
        warn(f"{label}: hopen cannot read the env file {clean(file)}. hopen skips it.")
        return
    items, names = [], []
    for number, line in enumerate(lines, 1):
        line = line.strip()
        if not line or line.startswith("#"):
            continue
        if line.startswith("export "):
            line = line[len("export "):].lstrip()
        key, sep, value = line.partition("=")
        key, value = key.strip(), value.strip()
        if not sep or not ENV_NAME.fullmatch(key):
            warn(f"{label}: line {number} of {clean(file)} is not KEY=VALUE. hopen skips it.")
            continue
        if len(value) >= 2 and value[0] == value[-1] and value[0] in "\"'":
            value = value[1:-1]
        elif " #" in value:
            value = value.split(" #", 1)[0].rstrip()
        if RISKY.fullmatch(key):
            warn(f"{label}: an env file cannot set {key}, because it can run code. Put it in env, where the approval question shows it.")
            continue
        items.append(f"{key}={clean(value)}")
        names.append(f"{key}=(hidden)" if SECRET.fullmatch(key) else f"{key}={clean(value)}")
    if items:
        emit("F", label, file, ", ".join(names), env=items)

TASK_NAME = re.compile(r"[A-Za-z0-9][A-Za-z0-9_.:-]*")

def tasks(label, values):
    # A task is a name and a command, like a task of tasks.json in VS Code.
    if not values:
        return
    if not isinstance(values, dict):
        warn(f"{label}: tasks must be a map of names to commands. hopen skips them.")
        return
    for name, command in values.items():
        if not TASK_NAME.fullmatch(str(name)) or not isinstance(command, str) or not clean(command):
            warn(f"{label}: the task {clean(name)} is not valid. A task is a name of letters, numbers, and . _ : -, and a command.")
            continue
        emit("K", label, name, command)

if parent:
    if not clean(session):
        sys.exit("The session name of the list is empty.")
    env_file(clean(session), parent_env_file, base)
    emit("R", session, base, template(parent_template, clean(session)), field(parent_open), env=env_items(clean(session), parent_env))
    tasks(clean(session), parent_tasks)
for project in projects:
    full = list_path(project["path"])
    if full is None:
        warn(f"A project path has a control character, so hopen skips it: {project['path']}")
        continue
    label = clean(project["name"] or os.path.basename(full))
    if not label or label == "-":
        warn(f"A project has an empty name, so hopen skips it: {project['path']}")
        continue
    env_file(label, project["env_file"], full)
    emit("P", label, full, template(project["template"], label), field(project["on_open"]), env=env_items(label, project["env"]))
    tasks(label, project["tasks"])
    tabs = project["tabs"]
    if not isinstance(tabs, list):
        warn(f"{label}: tabs must be a list. hopen skips them.")
        continue
    for tab in tabs:
        if not isinstance(tab, dict) or clean(tab.get("name") or "") in ("", "-"):
            warn(f"{label}: each tab needs a name. hopen skips one tab.")
            continue
        emit("T", label, tab["name"], template_name(tab.get("template"), f"{label}, tab {clean(tab['name'])}") or "plain", field(tab.get("run", "")))
PY
}

# find_lists prints one "session<TAB>file" line for each project list.
#
# A list can name its session with "session" or "hopen.session". That name
# never takes over a list whose own file or folder has the name of the session:
# a list that only claims a name gets a warning, and hopen skips it. If two
# lists only claim one name, hopen skips both. If a herdspace.toml and a VS Code
# list both have the name, hopen uses herdspace.toml, and it prints a warning.
find_lists() {
  local file name session
  {
    for file in "$HOME"/*/herdspace.toml; do
      [ -f "$file" ] || continue
      name="$(basename "$(dirname "$file")")"
      session="$(read_list "$file" session 2>&1)" || { warn "Skipped ${file}. ${session}"; continue; }
      valid_name "$session" && printf '%s\t%s\t%s\n' "$session" "$file" "$([ "$session" = "$name" ] && echo own || echo claimed)"
    done
    for file in "$HOME"/*.code-workspace "$HOME"/*/*.code-workspace; do
      [ -f "$file" ] || continue
      name="$(basename "$file" .code-workspace)"
      case "$file" in
        "${HOME}/${name}.code-workspace" | "${HOME}/${name}/${name}.code-workspace") ;;
        *) continue ;;
      esac
      session="$(read_list "$file" session 2>&1)" || { warn "Skipped ${file}. ${session}"; continue; }
      valid_name "$session" && printf '%s\t%s\t%s\n' "$session" "$file" "$([ "$session" = "$name" ] && echo own || echo claimed)"
    done
  } | awk -F '\t' '
    { order[NR] = $1; file[NR] = $2; kind[NR] = $3; count[$1 SUBSEP $3]++ }
    END {
      for (i = 1; i <= NR; i++) {
        s = order[i]
        if (done[s]) continue
        if (count[s SUBSEP "own"] > 0) {
          if (kind[i] != "own") continue
          done[s] = 1
          print s "\t" file[i]
          for (j = 1; j <= NR; j++) {
            if (j == i || order[j] != s) continue
            if (kind[j] == "own") printf "  [warn] Session %s has two lists. hopen uses %s.\n", s, file[i] > "/dev/stderr"
            else printf "  [warn] %s claims the session %s, which %s has. hopen skips it.\n", file[j], s, file[i] > "/dev/stderr"
          }
        } else if (count[s SUBSEP "claimed"] > 1) {
          done[s] = 1
          printf "  [warn] Two lists claim the session %s. hopen skips both. Give one another name:\n", s > "/dev/stderr"
          for (j = 1; j <= NR; j++) if (order[j] == s) printf "         %s\n", file[j] > "/dev/stderr"
        } else {
          done[s] = 1
          print s "\t" file[i]
        }
      }
    }'
}

find_list_for() {
  find_lists | awk -F '\t' -v n="$1" '$1 == n {print $2}'
}

# ---------- sessions

session_answers() {
  local output
  output="$(HERDR_SESSION="$SESSION" herdr workspace list 2>/dev/null)" || return 1
  [[ "$output" == *workspace_list* ]]
}

start_session() {
  HERDR_SESSION="$SESSION" nohup herdr server >/dev/null 2>&1 &
  disown
  STARTED=1
  for _ in $(seq 1 40); do
    session_answers && return 0
    sleep 0.25
  done
  die "The session ${SESSION} did not start."
}

# workspaces prints one "label<TAB>workspace id" line for each workspace.
workspaces() {
  HERDR_SESSION="$SESSION" herdr workspace list | python3 -I -c '
import json, sys
for w in json.load(sys.stdin)["result"]["workspaces"]:
    print(w["label"], w["workspace_id"], sep="\t")
'
}

# panes_of WORKSPACE prints one "label<TAB>pane id" line for each pane.
panes_of() {
  HERDR_SESSION="$SESSION" herdr pane list | python3 -I -c '
import json, sys
for p in json.load(sys.stdin)["result"]["panes"]:
    if p["workspace_id"] == sys.argv[1]:
        print(p.get("label") or "", p["pane_id"], sep="\t")
' "$1"
}

# pane_is_idle exits 0 if the pane shows its shell prompt, with no program.
pane_is_idle() {
  local info
  for _ in $(seq 1 20); do
    info="$(HERDR_SESSION="$SESSION" herdr pane process-info --pane "$1" 2>/dev/null)" || info=""
    case "$info" in
      *shell_pid*)
        python3 -I -c '
import json, sys
p = json.load(sys.stdin)["result"]["process_info"]
sys.exit(0 if p.get("shell_pid") and p.get("foreground_process_group_id") == p.get("shell_pid") else 1)
' <<<"$info"
        return
        ;;
    esac
    sleep 0.25
  done
  return 1
}

state_file() { printf '%s/%s.tsv' "$STATE_DIR" "$SESSION"; }

# remember_template LABEL TEMPLATE PANES writes one state line for a workspace.
# PANES is "id=name id=name". Herdr keeps the pane IDs after a restart, so
# hopen finds each template pane by its ID, even if a plugin renamed it.
remember_template() {
  local file
  file="$(state_file)"
  mkdir -p "$STATE_DIR"
  touch "$file"
  awk -F '\t' -v l="$1" '$1 != l' "$file" >"${file}.tmp"
  printf '%s\t%s\t%s\n' "$1" "$2" "${3:-}" >>"${file}.tmp"
  mv "${file}.tmp" "$file"
}

# restart_programs starts each template program again in a pane that shows only
# its shell. Herdr restores the panes after a stop, but not their programs.
restart_programs() {
  local file label template id panes pane from direction size command pane_id restarted=0
  file="$(state_file)"
  [ -f "$file" ] || return 0
  local all
  all="$(workspaces)"
  while IFS=$'\t' read -r label template saved; do
    template_exists "$template" && [ "$template" != plain ] || continue
    # A tab of a workspace has the state label "workspace/tab".
    id="$(awk -F '\t' -v l="${label%%/*}" '$1 == l {print $2}' <<<"$all")"
    [ -n "$id" ] || continue
    panes="$(panes_of "$id")"
    while read -r pane from direction size command; do
      # The saved ID comes first. The name is for state from older versions.
      pane_id="$(tr ' ' '\n' <<<"${saved:-}" | awk -F '=' -v n="$pane" '$2 == n {print $1; exit}')"
      if [ -z "$pane_id" ] || ! cut -f2 <<<"$panes" | grep -Fxq -- "$pane_id"; then
        pane_id="$(awk -F '\t' -v l="$pane" '$1 == l {print $2; exit}' <<<"$panes")"
      fi
      [ -n "$pane_id" ] || continue
      GUARD_PAIRS="${GUARD_PAIRS}${pane_id}"$'\t'"${pane}"$'\n'
      [ -n "$command" ] && [ "$command" != "-" ] || continue
      if pane_is_idle "$pane_id"; then
        HERDR_SESSION="$SESSION" herdr pane run "$pane_id" "$command" >/dev/null
        restarted=$((restarted + 1))
      fi
    done < <(template_lines "$template")
  done <"$file"
  [ "$restarted" -eq 0 ] || printf '  [info] Session %s: %s programs started again.\n' "$SESSION" "$restarted"
}

# ---------- trust

# list_actions ITEMS prints each command and environment value of a list.
list_actions() {
  awk -F '\036' '
    ($1 == "R" || $1 == "P") && $5 != "-" { print "    " $2 ": run " $5 }
    ($1 == "R" || $1 == "P") && $6 != "-" { gsub("\037", ", ", $6); print "    " $2 ": set " $6 }
    $1 == "T" && $5 != "-" { print "    " $2 ", tab " $3 ": run " $5 }
    $1 == "F" { print "    " $2 ": load " $3 " (" $4 ")" }
    $1 == "K" { print "    " $2 ", task " $3 ": run " $4 }
  ' <<<"$1"
}

# file_hash FILE [EXTRA] prints the checksum of FILE. EXTRA is the values that
# the list loads from env files, so that a change to them asks again. EXTRA
# goes on stdin, because another user can read the arguments of a process.
file_hash() {
  printf '%s' "${2:-}" | python3 -I -c '
import hashlib, sys
digest = hashlib.sha256(open(sys.argv[1], "rb").read())
extra = sys.stdin.buffer.read()
if extra:
    digest.update(b"\0" + extra)
print(digest.hexdigest())
' "$1"
}
trust_file() { printf '%s/trusted.tsv' "$STATE_DIR"; }

# list_trusted FILE ACTIONS [EXTRA] exits 0 if hopen can use the commands and values of
# FILE: the person approved this version of the file before, approves it now,
# or gave --trust. A changed file needs a new approval.
list_trusted() {
  local file="$1" actions="$2" hash answer
  hash="$(file_hash "$file" "${3:-}")" || return 1
  [[ "$hash" =~ ^[0-9a-f]{64}$ ]] || return 1
  awk -F '\t' -v f="$file" -v h="$hash" '$1 == f && $2 == h { found = 1 } END { exit !found }' "$(trust_file)" 2>/dev/null && return 0
  if [ "$TRUST_FLAG" -ne 1 ]; then
    [ -t 0 ] || return 1
    printf '  [info] %s runs these commands and sets these values:\n%s\n' "$(short_path "$file")" "$actions"
    printf '  Use them? Answer yes only for a list that you trust. [y/N] '
    IFS= read -r answer || answer=""
    case "$answer" in y | Y | yes | Yes) ;; *) return 1 ;; esac
  fi
  mkdir -p "$STATE_DIR"
  { awk -F '\t' -v f="$file" '$1 != f' "$(trust_file)" 2>/dev/null || true; printf '%s\t%s\n' "$file" "$hash"; } >"$(trust_file).new"
  mv "$(trust_file).new" "$(trust_file)"
}

# open_template TEMPLATE PANE STATE_LABEL splits PANE with TEMPLATE, starts its
# programs, and remembers the panes under STATE_LABEL.
open_template() {
  local template="$1" root="$2" state_label="$3" before
  [ "$template" != plain ] || return 0
  before="$GUARD_PAIRS"
  HERDR_SESSION="$SESSION" apply_template "$template" "$root"
  remember_template "$state_label" "$template" "$(printf '%s' "${GUARD_PAIRS#"$before"}" | tr '\t' '=' | tr '\n' ' ' | sed 's/ $//')"
}

# prepare_session starts SESSION and adds each folder that has no workspace.
# A new workspace gets its template, its on-open command, and its extra tabs.
prepare_session() {
  local items existing added=0 kind label folder template extra envs output root workspace_id item
  local current="" current_folder="" current_id="" file_env="" key
  STARTED=0
  session_answers || start_session
  [ "$STARTED" -eq 0 ] || restart_programs
  if [ -n "$FOLDER" ]; then
    # A folder with no list: one workspace, with no commands or values.
    items="$(printf 'R\036%s\036%s\036%s\036-\036-' "$SESSION" "$FOLDER" "${TEMPLATE_FLAG:-plain}")"
  else
    items="$(read_list "$LIST_FILE" items)" || die "Could not read ${LIST_FILE}."
  fi
  local actions trusted=1
  actions="$(list_actions "$items")"
  if [ -n "$actions" ] && ! list_trusted "$LIST_FILE" "$actions" "$(grep $'^F\x1e' <<<"$items" || true)"; then
    trusted=0
    warn "hopen did not use the commands and values of $(short_path "$LIST_FILE"). Run hopen in a terminal to approve them, or add --trust."
  fi
  existing="$(workspaces | cut -f1)"
  while IFS=$'\x1e' read -r kind label folder template extra envs; do
    [ "$extra" != "-" ] && [ "$trusted" -eq 1 ] || extra=""
    [ "$envs" != "-" ] && [ "$trusted" -eq 1 ] || envs=""
    case "$kind" in
      W) warn "$label"; continue ;;
      F)
        # The values of an env file, for the R or P line that comes next.
        # "extra" holds them here, and it is empty with no approval.
        file_env="$extra"
        continue
        ;;
      T)
        # A tab line: label, tab name (in "folder"), template, command.
        [ "$label" = "$current" ] && [ -n "$current_id" ] || continue
        if ! template_exists "$template"; then
          warn "${label}/${folder}: no template named ${template}. The tab opens with one pane."
          template="plain"
        fi
        output="$(HERDR_SESSION="$SESSION" herdr tab create --workspace "$current_id" --cwd "$current_folder" --label "$folder" --no-focus ${ENV_ARGS[@]+"${ENV_ARGS[@]}"})"
        root="$(json_get "d['result']['root_pane']['pane_id']" <<<"$output")"
        GUARD_TABS="${GUARD_TABS}${root}"$'\t'"${folder}"$'\n'
        open_template "$template" "$root" "${label}/${folder}"
        [ -z "$extra" ] || HERDR_SESSION="$SESSION" herdr pane run "$root" "$extra" >/dev/null
        continue
        ;;
      R) label="$SESSION" ;;
      P) ;;
      *) continue ;;
    esac
    current="$label"
    current_folder="$folder"
    current_id=""
    ENV_ARGS=()
    if [ -n "$envs" ]; then
      while IFS= read -r -d $'\x1f' item; do
        [ -z "$item" ] || ENV_ARGS+=(--env "$item")
      done <<<"${envs}"$'\x1f'
    fi
    # A value from the env file is used only if env does not set the name.
    if [ -n "$file_env" ]; then
      while IFS= read -r -d $'\x1f' item; do
        key="${item%%=*}"
        [ -n "$item" ] || continue
        case $'\x1f'"${envs}"$'\x1f' in *$'\x1f'"${key}="*) continue ;; esac
        ENV_ARGS+=(--env "$item")
      done <<<"${file_env}"$'\x1f'
    fi
    file_env=""
    if grep -Fxq -- "$label" <<<"$existing"; then
      continue
    fi
    if [ ! -d "$folder" ]; then
      warn "Skipped ${label}: the folder ${folder} does not exist."
      continue
    fi
    if ! template_exists "$template"; then
      warn "${label}: no template named ${template}. It opens with one pane."
      template="plain"
    fi
    output="$(HERDR_SESSION="$SESSION" herdr workspace create --cwd "$folder" --label "$label" --no-focus ${ENV_ARGS[@]+"${ENV_ARGS[@]}"})"
    root="$(json_get "d['result']['root_pane']['pane_id']" <<<"$output")"
    workspace_id="$(json_get "d['result']['workspace']['workspace_id']" <<<"$output")"
    current_id="$workspace_id"
    # The on-open command runs first. The shell then starts the template program.
    [ -z "$extra" ] || HERDR_SESSION="$SESSION" herdr pane run "$root" "$extra" >/dev/null
    open_template "$template" "$root" "$label"
    added=$((added + 1))
  done <<<"$items"
  printf '  [info] Session %s: %s workspaces added.\n' "$SESSION" "$added"
  template_note "$items" "$added"
  HERDR_SESSION="$SESSION" guard_names
}

# template_note ITEMS ADDED explains --template when it did not split each
# project: the template applies only to the workspaces that the run creates.
template_note() {
  [ -n "$TEMPLATE_FLAG" ] || return 0
  local total existing
  total="$(printf '%s\n' "$1" | awk -F '\036' '$1 == "R" || $1 == "P"' | wc -l | tr -d ' ')"
  existing=$((total - $2))
  [ "$existing" -gt 0 ] || return 0
  if [ "$2" -eq 0 ]; then
    printf '  [info] --template %s splits only new projects, and each project of %s has a workspace already.\n' "$TEMPLATE_FLAG" "$SESSION"
  else
    printf '  [info] --template %s split the %s new projects. %s projects existed already.\n' "$TEMPLATE_FLAG" "$2" "$existing"
  fi
  printf '         To split a project that exists, go to its tab in Herdr, and run: hopen --apply %s\n' "$TEMPLATE_FLAG"
}

attach_session() {
  if [ "${HERDR_ENV:-}" = "1" ]; then
    die "You are in a Herdr pane. Press ctrl+b, then q, and run this command again."
  fi
  exec herdr session attach "$SESSION"
}

show_lists() {
  local lists name state count
  lists="$(find_lists)"
  [ -n "$lists" ] || die "No project lists. Create ~/my-projects.code-workspace or ~/my-projects/herdspace.toml."
  printf '%-22s %-9s %-11s %s\n' SESSION STATE WORKSPACES LIST
  while IFS=$'\t' read -r name LIST_FILE; do
    SESSION="$name"
    if session_answers; then
      state="running"
      count="$(workspaces | wc -l | tr -d ' ')"
    else
      state="stopped"
      count="-"
    fi
    printf '%-22s %-9s %-11s %s\n' "$name" "$state" "$count" "$(short_path "$LIST_FILE")"
  done <<<"$lists"
}

open_all() {
  local lists wanted="$SESSION" name
  lists="$(find_lists)"
  [ -n "$lists" ] || die "No project lists. Create ~/my-projects.code-workspace or ~/my-projects/herdspace.toml."
  if [ -n "$wanted" ] && ! grep -q "^${wanted}"$'\t' <<<"$lists"; then
    die "No project list for ${wanted}."
  fi
  while IFS=$'\t' read -r name LIST_FILE; do
    SESSION="$name"
    prepare_session
  done <<<"$lists"
  if [ -n "$wanted" ]; then
    SESSION="$wanted"
    attach_session
  fi
  printf '  [info] Run hopen with a session name to attach, for example: hopen %s\n' "$(printf '%s' "$lists" | head -n 1 | cut -f1)"
}

# apply_here splits the current tab of a Herdr pane with a template.
apply_here() {
  # A popup of Herdr has no pane of its own, so it applies to the active pane.
  local target="${HERDR_PANE_ID:-${HERDR_ACTIVE_PANE_ID:-}}"
  [ -n "$target" ] || die "Run --apply inside a Herdr pane."
  template_exists "$APPLY_NAME" || die "No template named ${APPLY_NAME}. Run hopen --templates."
  [ "$APPLY_NAME" != plain ] || return 0
  local tab count
  tab="$(herdr pane list | python3 -I -c '
import json, sys
print([p["tab_id"] for p in json.load(sys.stdin)["result"]["panes"] if p["pane_id"] == sys.argv[1]][0])
' "$target")"
  count="$(herdr pane list | python3 -I -c '
import json, sys
print(len([p for p in json.load(sys.stdin)["result"]["panes"] if p["tab_id"] == sys.argv[1]]))
' "$tab")"
  [ "$count" = 1 ] || die "The current tab has ${count} panes. Open a new tab, and run --apply there."
  apply_template "$APPLY_NAME" "$target"
  guard_names
}

# convert_list writes ~/SESSION/herdspace.toml from the VS Code list of SESSION.
# It never replaces a file.
convert_list() {
  local source target items
  target="${HOME}/${SESSION}/herdspace.toml"
  [ ! -e "$target" ] || die "${target} exists. Move it, and run --convert again."
  source="$(find_list_for "$SESSION")"
  case "$source" in
    *.code-workspace) ;;
    *) die "No VS Code list for ${SESSION}." ;;
  esac
  mkdir -p "${HOME}/${SESSION}"
  items="$(mktemp)"
  read_list "$source" items >"$items" || { rm -f "$items"; die "Could not read ${source}."; }
  python3 -I - "$source" "$target" "$HOME" "$items" <<'PY'
import os, sys

source, target, home, items = sys.argv[1:5]
target_dir = os.path.dirname(target)

def quote(text):
    return '"' + text.replace("\\", "\\\\").replace('"', '\\"') + '"'

def where(path):
    relative = os.path.relpath(path, target_dir)
    if not relative.startswith(".."):
        return relative
    if path.startswith(home + os.sep):
        return "~/" + os.path.relpath(path, home)
    return path

def env_table(pairs):
    return "{ " + ", ".join(key + " = " + quote(value) for key, value in pairs) + " }"

def task_table(pairs):
    return "{ " + ", ".join(quote(name) + " = " + quote(command) for name, command in pairs) + " }"

def near(path, folder):
    # A path relative to folder if it is inside folder, else ~/... or absolute.
    relative = os.path.relpath(path, folder)
    if not relative.startswith(".."):
        return relative
    if path.startswith(home + os.sep):
        return "~/" + os.path.relpath(path, home)
    return path

parent = None
projects = []
pending_file = ""
# splitlines() also ends a line at the byte 0x1e, so split at new lines only.
for raw in open(items, encoding="utf-8").read().split("\n"):
    if not raw:
        continue
    kind, *fields = raw.split("\x1e")
    fields = ["" if value == "-" else value for value in fields] + [""] * 5
    if kind == "F":
        # Keep the path of the env file, not its values.
        pending_file = fields[1]
    elif kind in ("R", "P"):
        entry = {"label": fields[0], "path": fields[1], "template": fields[2], "on_open": fields[3], "tabs": [],
                 "env": [item.split("=", 1) for item in fields[4].split("\x1f") if "=" in item],
                 "env_file": pending_file}
        pending_file = ""
        if kind == "R":
            parent = entry
        else:
            projects.append(entry)
    elif kind == "K":
        owner = projects[-1] if projects else parent
        if owner is not None and owner["label"] == fields[0]:
            owner.setdefault("tasks", []).append((fields[1], fields[2]))
    elif kind == "T" and projects and projects[-1]["label"] == fields[0]:
        projects[-1]["tabs"].append({"name": fields[1], "template": fields[2], "run": fields[3]})

lines = ["# Written by hopen --convert from " + source.replace(home, "~", 1) + ".", ""]
if parent is None:
    lines += ["parent_workspace = false", ""]
else:
    if parent["template"] != "plain":
        lines.append("parent_template = " + quote(parent["template"]))
    if parent["on_open"]:
        lines.append("on_open = " + quote(parent["on_open"]))
    if parent["env"]:
        lines.append("env = " + env_table(parent["env"]))
    if parent["env_file"]:
        lines.append("env_file = " + quote(near(parent["env_file"], target_dir)))
    if parent.get("tasks"):
        lines.append("tasks = " + task_table(parent["tasks"]))
    if len(lines) > 2:
        lines.append("")
for project in projects:
    lines += ["[[project]]", "name = " + quote(project["label"]), "path = " + quote(where(project["path"]))]
    if project["template"] != "plain":
        lines.append("template = " + quote(project["template"]))
    if project["on_open"]:
        lines.append("on_open = " + quote(project["on_open"]))
    if project["env"]:
        lines.append("env = " + env_table(project["env"]))
    if project["env_file"]:
        lines.append("env_file = " + quote(near(project["env_file"], project["path"])))
    if project.get("tasks"):
        lines.append("tasks = " + task_table(project["tasks"]))
    if project["tabs"]:
        tabs = []
        for tab in project["tabs"]:
            text = "{ name = " + quote(tab["name"]) + ", template = " + quote(tab["template"])
            if tab["run"]:
                text += ", run = " + quote(tab["run"])
            tabs.append(text + " }")
        lines.append("tabs = [" + ", ".join(tabs) + "]")
    lines.append("")
with open(target, "w", encoding="utf-8") as handle:
    handle.write("\n".join(lines).rstrip() + "\n")
PY
  rm -f "$items"
  printf '  [info] Wrote %s. hopen now uses it in place of %s.\n' "$(short_path "$target")" "$(short_path "$source")"
}

# choose PROMPT shows a menu of the lines on stdin, one "key<TAB>text" line for
# each item, and prints the key that the person chose. It uses fzf if it is
# installed, else a numbered menu that takes a number or a key. It prints
# nothing if the person cancels, and it exits 1 for an unknown answer.
choose() {
  local prompt="$1" items answer="" name text i=0
  items="$(cat)"
  # fzf draws nothing with no TERM, or with TERM=dumb.
  if command -v fzf >/dev/null 2>&1 && [ -n "${TERM:-}" ] && [ "${TERM}" != dumb ]; then
    fzf --delimiter '\t' --with-nth 2.. --prompt "${prompt} > " --header 'Esc cancels.' --height 40% --reverse --no-multi <<<"$items" | cut -f1 || true
    return 0
  fi
  while IFS=$'\t' read -r name text; do
    i=$((i + 1))
    printf '  %2d) %s\n' "$i" "$text" >&2
  done <<<"$items"
  printf '  %s? Type a number or a name: ' "$prompt" >&2
  # The items came on stdin, so the answer comes from the terminal.
  IFS= read -r answer </dev/tty || answer=""
  case "$answer" in
    "") return 0 ;;
    *[!0-9]*) name="$(awk -F '\t' -v n="$answer" '$1 == n {print $1; exit}' <<<"$items")" ;;
    *) name="$(awk -F '\t' -v n="$answer" 'NR == n {print $1; exit}' <<<"$items")" ;;
  esac
  [ -n "$name" ] || { printf '  [err]  No item %s.\n' "$answer" >&2; return 1; }
  printf '%s\n' "$name"
}

# project_for_dir DIR prints "list file<TAB>label" for the project that holds
# DIR. The deepest project folder wins, so a project wins over the parent
# workspace of its list.
project_for_dir() {
  local dir="$1" name file
  find_lists 2>/dev/null | while IFS=$'\t' read -r name file; do
    read_list "$file" items 2>/dev/null | awk -F '\036' -v f="$file" '($1 == "R" || $1 == "P") { print $3 "\t" f "\t" $2 }'
  done | awk -F '\t' -v d="$dir" '
    (d == $1 || index(d, $1 "/") == 1) && length($1) > best { best = length($1); found = $2 "\t" $3 }
    END { if (found == "") exit 1; print found }'
}

# env_for ITEMS LABEL sets ENV_ARGS to the environment values of one project:
# its env values, and the values of its env file that env does not set.
env_for() {
  local items="$1" label="$2" envs file_env item key
  envs="$(awk -F '\036' -v l="$label" '($1 == "R" || $1 == "P") && $2 == l && $6 != "-" { print $6; exit }' <<<"$items")"
  file_env="$(awk -F '\036' -v l="$label" '$1 == "F" && $2 == l { print $5; exit }' <<<"$items")"
  ENV_ARGS=()
  if [ -n "$envs" ]; then
    while IFS= read -r -d $'\x1f' item; do
      [ -z "$item" ] || ENV_ARGS+=(--env "$item")
    done <<<"${envs}"$'\x1f'
  fi
  if [ -n "$file_env" ]; then
    while IFS= read -r -d $'\x1f' item; do
      key="${item%%=*}"
      [ -n "$item" ] || continue
      case $'\x1f'"${envs}"$'\x1f' in *$'\x1f'"${key}="*) continue ;; esac
      ENV_ARGS+=(--env "$item")
    done <<<"${file_env}"$'\x1f'
  fi
}

# run_task runs a task of the project of the current folder. In Herdr, it runs
# in a new pane below the current pane. A popup of Herdr has no pane of its
# keep_pane_name PANE NAME sets the name again if a plugin changed it. The Auto
# Title plugin can name a new pane when it first sees it, also a pane that has a
# name already. It keeps a name that changes after that first sighting.
keep_pane_name() {
  local pane="$1" name="$2" _try label
  for _try in 1 2; do
    sleep 1
    label="$(herdr pane list 2>/dev/null | python3 -I -c 'import json,sys
for p in json.load(sys.stdin)["result"]["panes"]:
    if p["pane_id"] == sys.argv[1]: print(p.get("label") or "")' "$pane" 2>/dev/null)" || return 0
    [ "$label" = "$name" ] || herdr pane rename "$pane" "$name" >/dev/null 2>&1 || return 0
  done
}

# own, so there it splits the active pane. Outside Herdr, it runs here.
run_task() {
  local dir="${HERDR_ACTIVE_PANE_CWD:-$PWD}" match file label items tasks command actions output pane item
  match="$(project_for_dir "$dir")" || die "No project of a list holds the folder $(short_path "$dir")."
  file="${match%%$'\t'*}"
  label="${match#*$'\t'}"
  items="$(read_list "$file" items)" || die "Could not read ${file}."
  tasks="$(awk -F '\036' -v l="$label" '$1 == "K" && $2 == l { print $3 "\t" $4 }' <<<"$items")"
  [ -n "$tasks" ] || die "The project ${label} has no tasks. Add tasks to $(short_path "$file"). See https://github.com/MussaCharles/herdspace/blob/main/docs/hopen.md#tasks"
  if [ -z "$TASK_NAME" ]; then
    if [ -t 0 ] && [ -t 1 ]; then
      TASK_NAME="$(while IFS=$'\t' read -r item command; do printf '%s\t%-14s %s\n' "$item" "$item" "$command"; done <<<"$tasks" | choose "Run which task")" || exit 1
      [ -n "$TASK_NAME" ] || exit 0
    else
      printf '%s\n' "$tasks"
      return 0
    fi
  fi
  command="$(awk -F '\t' -v n="$TASK_NAME" '$1 == n { print $2; exit }' <<<"$tasks")"
  [ -n "$command" ] || die "The project ${label} has no task ${TASK_NAME}. Its tasks: $(cut -f1 <<<"$tasks" | tr '\n' ' ')"
  actions="$(list_actions "$items")"
  list_trusted "$file" "$actions" "$(grep $'^F\x1e' <<<"$items" || true)" ||
    die "hopen runs a task only from an approved list. Run hopen --task in a terminal to approve $(short_path "$file"), or add --trust."
  env_for "$items" "$label"
  pane="${HERDR_PANE_ID:-${HERDR_ACTIVE_PANE_ID:-}}"
  if [ -n "$pane" ]; then
    output="$(herdr pane split "$pane" --direction down --ratio 0.65 --focus ${ENV_ARGS[@]+"${ENV_ARGS[@]}"})" || die "Could not split the pane."
    pane="$(json_get "d['result']['pane']['pane_id']" <<<"$output")"
    herdr pane rename "$pane" "$TASK_NAME" >/dev/null
    herdr pane run "$pane" "cd $(printf '%q' "$dir") && ${command}" >/dev/null
    printf '  [info] Task %s runs in a new pane: %s\n' "$TASK_NAME" "$command"
    keep_pane_name "$pane" "$TASK_NAME"
  else
    printf '  [info] Task %s: %s\n' "$TASK_NAME" "$command"
    for item in ${ENV_ARGS[@]+"${ENV_ARGS[@]}"}; do
      [ "$item" = --env ] || export "${item?}"
    done
    cd "$dir" && exec "${SHELL:-/bin/sh}" -c "$command"
  fi
}

# ---------- quick open and search, like Ctrl+P and Ctrl+Shift+F in VS Code

# open_in_editor FILE [LINE] opens FILE in $VISUAL or $EDITOR, or else Neovim.
open_in_editor() {
  local editor="${VISUAL:-${EDITOR:-nvim}}"
  case "$(basename "${editor%% *}")" in
    code | code-insiders | cursor) exec ${editor} --goto "$1${2:+:$2}" ;;
    *) if [ -n "${2:-}" ]; then exec ${editor} "+$2" "$1"; else exec ${editor} "$1"; fi ;;
  esac
}

need() { command -v "$1" >/dev/null 2>&1 || die "$2 needs $1. The server setup installs it."; }

list_files() {
  if command -v fd >/dev/null 2>&1; then fd --type f --hidden --exclude .git
  elif command -v fdfind >/dev/null 2>&1; then fdfind --type f --hidden --exclude .git
  else find . -type f ! -path '*/.git/*'
  fi
}

# find_file lets the person choose a file in the current folder with fzf, and
# opens it. It uses fd, or fdfind on Debian, or find.
find_file() {
  local file preview="cat {}"
  need fzf "hopen --find"
  [ -t 0 ] && [ -t 1 ] || die "hopen --find needs a terminal."
  command -v bat >/dev/null 2>&1 && preview="bat --color=always --style=numbers {}"
  file="$(cd "$DIR" && list_files | sed 's|^\./||' | fzf --prompt 'Open file > ' --preview "$preview" --height 80% --reverse)" || true
  [ -n "$file" ] || exit 0
  cd "$DIR" && open_in_editor "$file"
}

# grep_files searches the files of the current folder with ripgrep, lets the
# person choose a result with fzf, and opens the file at that line.
grep_files() {
  local hit preview="sed -n '{2},+20p' {1}"
  need rg "hopen --grep"
  need fzf "hopen --grep"
  [ -t 0 ] && [ -t 1 ] || die "hopen --grep needs a terminal."
  command -v bat >/dev/null 2>&1 && preview="bat --color=always --style=numbers --highlight-line {2} {1}"
  hit="$(cd "$DIR" && rg --line-number --no-heading --color=always --smart-case --fixed-strings -- "$GREP_TEXT" |
    fzf --ansi --delimiter : --prompt "Search ${GREP_TEXT} > " --preview "$preview" --preview-window '+{2}-5' --height 80% --reverse)" || true
  [ -n "$hit" ] || exit 0
  cd "$DIR" && open_in_editor "$(cut -d: -f1 <<<"$hit")" "$(cut -d: -f2 <<<"$hit")"
}

# ---------- ports, like the Ports view of VS Code

# show_ports prints each TCP port that a program of this user listens on, with
# the program, its process ID, and the project that holds its folder.
show_ports() {
  local projects name file
  # One "folder<TAB>session/label" line for each project of each list.
  projects="$(find_lists 2>/dev/null | while IFS=$'\t' read -r name file; do
    read_list "$file" items 2>/dev/null | awk -F '\036' -v s="$name" '$1 == "R" { print $3 "\t" s } $1 == "P" { print $3 "\t" s "/" $2 }'
  done)"
  printf '%s' "$projects" | python3 -I -c '
import os, subprocess, sys

home = os.path.expanduser("~")
# The real paths, because a folder can have two names, for example /var and
# /private/var on macOS.
projects = [(os.path.realpath(path), label) for path, label in
            (line.split("\t", 1) for line in sys.stdin.read().split("\n") if "\t" in line)]

def run(*args):
    try:
        return subprocess.run(args, capture_output=True, text=True, timeout=10).stdout
    except (OSError, subprocess.SubprocessError):
        return ""

def project_of(folder):
    folder = os.path.realpath(folder) if folder else folder
    best = ("", "-")
    for path, label in projects:
        if (folder == path or folder.startswith(path + "/")) and len(path) > len(best[0]):
            best = (path, label)
    return best[1]

ports = {}
if sys.platform == "darwin":
    pid = name = None
    for line in run("lsof", "-nP", "-a", "-u", str(os.getuid()), "-iTCP", "-sTCP:LISTEN", "-Fpcn").splitlines():
        if line[:1] == "p":
            pid = line[1:]
        elif line[:1] == "c":
            name = line[1:]
        elif line[:1] == "n" and pid:
            address, _, port = line[1:].rpartition(":")
            ports.setdefault((int(port), pid), (name, address))
    def cwd_of(pid):
        out = run("lsof", "-a", "-p", pid, "-d", "cwd", "-Fn")
        return next((line[1:] for line in out.splitlines() if line[:1] == "n"), "")
else:
    # /proc has the listening sockets and the processes that hold them, so
    # this needs no ss command.
    def address_of(text):
        address, port = text.split(":")
        raw = bytes.fromhex(address)
        if len(raw) == 4:
            host = ".".join(str(b) for b in raw[::-1])
        else:
            words = [raw[i:i + 4][::-1] for i in range(0, 16, 4)]
            host = ":".join(b"".join(words)[i:i + 2].hex() for i in range(0, 16, 2))
            host = {"0000:0000:0000:0000:0000:0000:0000:0000": "::",
                    "0000:0000:0000:0000:0000:0000:0000:0001": "::1"}.get(host, host)
        return host, int(port, 16)
    listening = {}
    for table in ("/proc/net/tcp", "/proc/net/tcp6"):
        try:
            lines = open(table).read().splitlines()[1:]
        except OSError:
            continue
        for line in lines:
            fields = line.split()
            if len(fields) > 9 and fields[3] == "0A":
                listening[fields[9]] = address_of(fields[1])
    for entry in os.listdir("/proc"):
        if not entry.isdigit():
            continue
        try:
            links = [os.readlink(f"/proc/{entry}/fd/{fd}") for fd in os.listdir(f"/proc/{entry}/fd")]
            name = open(f"/proc/{entry}/comm").read().strip()
        except OSError:
            continue
        for link in links:
            inode = link[8:-1] if link.startswith("socket:[") else None
            if inode in listening:
                host, port = listening[inode]
                ports.setdefault((port, entry), (name, host))
    def cwd_of(pid):
        try:
            return os.readlink(f"/proc/{pid}/cwd")
        except OSError:
            return ""

if not ports:
    print("No program of yours listens on a TCP port.")
    sys.exit(0)
row = "{:<7} {:<16} {:<16} {:<8} {:<22} {}"
print(row.format("PORT", "ADDRESS", "PROGRAM", "PID", "PROJECT", "FOLDER"))
for (port, pid), (name, address) in sorted(ports.items()):
    folder = cwd_of(pid)
    shown = "~" + folder[len(home):] if folder == home or folder.startswith(home + "/") else folder
    print(row.format(port, address.strip("[]"), (name or "-")[:16], pid, project_of(folder), shown or "-"))
'
}

# ---------- the command palette, like Ctrl+Shift+P in VS Code

# in_popup exits 0 in a Herdr popup, which closes when its command ends.
in_popup() { [ -z "${HERDR_PANE_ID:-}" ] && [ -n "${HERDR_ACTIVE_PANE_ID:-}" ]; }

# then_wait runs a command that prints a result. In a popup, it waits for
# Enter, so that the person can read the result.
then_wait() {
  "$@" || true
  if in_popup; then
    printf '\n  Press Enter to close.'
    IFS= read -r _ || true
  fi
}

# The command palette lists each action as "Group: Action", with its key or
# command at the right, as in VS Code. It shows only the actions that fit the
# place: in Herdr or not, in a project with tasks, in a git folder, on a client,
# and with the tools that are installed. PALETTE_RECENT keeps the ids of the
# last actions, with no paths and no text that the person typed.
PALETTE_RECENT="${XDG_CACHE_HOME:-$HOME/.cache}/herdspace/palette-recent"
PALETTE_ITEMS=""

# pal_add ID GROUP TEXT [HINT] adds one action.
pal_add() {
  local line
  line="$(printf '%s: %s' "$2" "$3")"
  [ -z "${4:-}" ] || line="$(printf '%-58s %s' "$line" "$4")"
  PALETTE_ITEMS="${PALETTE_ITEMS}$1"$'\t'"$2"$'\t'"${line}"$'\n'
}

# herdr_json ARGS... runs a Herdr command and prints one field of its result,
# for example "herdr_json root_pane.pane_id tab create ...".
herdr_json() {
  local field="$1"
  shift
  herdr "$@" 2>/dev/null | python3 -c '
import json, sys
value = json.load(sys.stdin).get("result", {})
for key in sys.argv[1].split("."):
    value = value.get(key, {}) if isinstance(value, dict) else {}
print(value if isinstance(value, str) else "")' "$field"
}

# ask_text PROMPT reads one line from the terminal.
ask_text() {
  local text=""
  printf '  %s: ' "$1" >&2
  IFS= read -r text </dev/tty || text=""
  printf '%s' "$text"
}

# confirm TEXT asks a yes or no question. The default is no.
confirm() {
  local answer=""
  printf '  %s [y/N] ' "$1" >&2
  IFS= read -r answer </dev/tty || answer=""
  case "$answer" in y | Y | yes) return 0 ;; *) return 1 ;; esac
}

# editor_command prints the editor to start, with the herdspace Neovim when the
# person has no Neovim files of their own.
editor_command() {
  if [ -n "${EDITOR:-}" ] && [ "$EDITOR" != nvim ]; then
    printf '%s' "$EDITOR"
  elif [ -z "${NVIM_APPNAME:-}" ] && [ ! -d "$HOME/.config/nvim" ] && [ -d "$HOME/.config/herdspace-nvim" ]; then
    printf 'NVIM_APPNAME=herdspace-nvim nvim'
  else
    printf 'nvim'
  fi
}

# new_tab_run LABEL DIR COMMAND opens a new tab in the current workspace and
# runs COMMAND in it.
new_tab_run() {
  local pane
  pane="$(herdr_json root_pane.pane_id tab create --workspace "$PAL_WS" --cwd "$2" --label "$1" --focus)"
  [ -n "$pane" ] || die "Herdr did not open a new tab."
  herdr pane run "$pane" "$3" >/dev/null
}

# split_run DIRECTION DIR [COMMAND] splits the current pane, and runs COMMAND
# in the new pane.
split_run() {
  local pane
  pane="$(herdr_json pane.pane_id pane split --pane "$PAL_PANE" --direction "$1" --cwd "$2" --focus)"
  [ -n "$pane" ] || die "Herdr did not split the pane."
  [ -z "${3:-}" ] || herdr pane run "$pane" "$3" >/dev/null
}

# focus_pane PANE moves the focus to PANE in its tab. Herdr moves the focus
# only from one pane to its neighbor, so this steps from the focused pane
# toward PANE through the layout, at most 8 times.
focus_pane() {
  local dir
  for _ in 1 2 3 4 5 6 7 8; do
    dir="$(herdr pane layout --pane "$1" 2>/dev/null | python3 -c '
import json, sys
target = sys.argv[1]
layout = json.load(sys.stdin).get("result", {}).get("layout", {})
rects = {p["pane_id"]: p["rect"] for p in layout.get("panes", [])}
here = layout.get("focused_pane_id")
if here == target or here not in rects or target not in rects:
    sys.exit(0)
def center(r):
    return (r["x"] + r["width"] / 2, r["y"] + r["height"] / 2)
(hx, hy), (tx, ty) = center(rects[here]), center(rects[target])
if abs(tx - hx) >= abs(ty - hy):
    print(("right" if tx > hx else "left") + " " + here)
else:
    print(("down" if ty > hy else "up") + " " + here)' "$1")"
    [ -n "$dir" ] || return 0
    herdr pane focus --pane "${dir#* }" --direction "${dir%% *}" >/dev/null 2>&1 || return 1
  done
}

# pane_runs PANE KIND is true when the foreground of PANE is Neovim or Vim
# (KIND editor), or only a shell at its prompt (KIND shell).
pane_runs() {
  herdr pane process-info --pane "$1" 2>/dev/null | python3 -c '
import json, sys
procs = json.load(sys.stdin).get("result", {}).get("process_info", {}).get("foreground_processes", [])
names = {p.get("name") for p in procs}
if sys.argv[1] == "editor":
    sys.exit(0 if names & {"nvim", "vim"} else 1)
sys.exit(0 if names and names <= {"zsh", "bash", "sh", "fish", "dash"} else 1)' "$2"
}

# editor_pane TAB prints the first pane of TAB that runs Neovim or Vim.
editor_pane() {
  local pane
  for pane in $(herdr pane list 2>/dev/null | python3 -c '
import json, sys
for p in json.load(sys.stdin).get("result", {}).get("panes", []):
    if p.get("tab_id") == sys.argv[1]:
        print(p["pane_id"])' "$1"); do
    if pane_runs "$pane" editor; then
      printf '%s\n' "$pane"
      return 0
    fi
  done
  return 1
}

# drop_in PANE PATH opens PATH in the Neovim of PANE, and focuses PANE.
drop_in() {
  herdr pane send-keys "$1" esc >/dev/null
  herdr pane send-text "$1" ":execute 'drop' fnameescape('${2//\'/\'\'}')" >/dev/null
  herdr pane send-keys "$1" enter >/dev/null
  focus_pane "$1" || true
}

# quick_open lets the person choose a file of the project, as Cmd+P does in VS
# Code, and opens it with the focus on it. In Herdr, Enter opens the file in
# the focused pane when it runs Neovim or is a shell at its prompt, else in the
# Neovim pane of the tab, else in a new split on the right. Ctrl+V, Ctrl+S, and
# Ctrl+T open a new editor on the right, below, or in a new tab. A new editor
# runs with exec, so that its pane closes when Neovim quits.
quick_open() {
  local root out key file path pane preview="cat {}" header
  need fzf "hopen --quick-open"
  [ -t 0 ] && [ -t 1 ] || die "hopen --quick-open needs a terminal."
  root="$(git -C "$DIR" rev-parse --show-toplevel 2>/dev/null || printf '%s' "$DIR")"
  command -v bat >/dev/null 2>&1 && preview="bat --color=always --style=numbers {}"
  PAL_PANE="${HERDR_ACTIVE_PANE_ID:-${HERDR_PANE_ID:-}}"
  PAL_WS="${HERDR_ACTIVE_WORKSPACE_ID:-${HERDR_WORKSPACE_ID:-}}"
  PAL_TAB="${HERDR_ACTIVE_TAB_ID:-${HERDR_TAB_ID:-}}"
  header="Type to filter. Enter opens the file. Esc closes. In Neovim, Ctrl+Q closes the file."
  [ -z "$PAL_PANE" ] || header="${header}"$'\n''Ctrl+V opens a new editor on the right, Ctrl+S below, Ctrl+T in a new tab.'
  out="$(cd "$root" && list_files | sed 's|^\./||' | fzf --prompt 'Open file > ' --header "$header" --expect ctrl-v,ctrl-s,ctrl-t --preview "$preview" --height 100% --reverse)" || true
  key="$(sed -n 1p <<<"$out")"
  file="$(sed -n 2p <<<"$out")"
  [ -n "$file" ] || exit 0
  path="${root}/${file}"
  if [ -z "$PAL_PANE" ]; then
    cd "$root" && open_in_editor "$file"
  fi
  case "$key" in ctrl-v) PAL_PLACE=right ;; ctrl-s) PAL_PLACE=down ;; ctrl-t) PAL_PLACE=tab ;; *) PAL_PLACE="" ;; esac
  if [ -z "$PAL_PLACE" ]; then
    if pane_runs "$PAL_PANE" editor; then
      drop_in "$PAL_PANE" "$path"
      exit 0
    fi
    if pane_runs "$PAL_PANE" shell; then
      herdr pane run "$PAL_PANE" "$(editor_command) $(printf '%q' "$path")" >/dev/null
      exit 0
    fi
    if pane="$(editor_pane "$PAL_TAB")"; then
      drop_in "$pane" "$path"
      exit 0
    fi
  fi
  run_at right "$(basename "$file")" "$root" "exec env $(editor_command) $(printf '%q' "$path")"
}

# run_at DEFAULT LABEL DIR [COMMAND] runs COMMAND in the place that the person
# chose in the palette (PAL_PLACE), or in DEFAULT: here, right, down, or tab.
# "here" replaces the palette with COMMAND. Outside Herdr, only "here" works.
run_at() {
  local place="${PAL_PLACE:-$1}"
  [ -n "$PAL_PANE" ] || place=here
  case "$place" in
    right | down) split_run "$place" "$3" "${4:-}" ;;
    tab)
      if [ -n "${4:-}" ]; then
        new_tab_run "$2" "$3" "$4"
      else
        herdr tab create --workspace "$PAL_WS" --cwd "$3" --label "$2" --focus >/dev/null
      fi
      ;;
    *)
      cd "$3" || die "No folder ${3}."
      if [ -n "${4:-}" ]; then eval "exec $4"; else exec "${SHELL:-sh}"; fi
      ;;
  esac
}

# agents_sorted prints "pane<TAB>agent<TAB>state<TAB>cwd" for each agent, the
# blocked and done agents first.
agents_sorted() {
  herdr agent list 2>/dev/null | python3 -c '
import json, sys
order = {"blocked": 0, "done": 1, "working": 2, "idle": 3}
agents = json.load(sys.stdin).get("result", {}).get("agents", [])
for a in sorted(agents, key=lambda a: order.get(a.get("agent_status"), 4)):
    print("\t".join([a.get("pane_id", ""), a.get("agent") or "agent", a.get("agent_status", ""), a.get("cwd", "")]))'
}

# worktrees DIR prints "path<TAB>branch<TAB>workspace" for each linked worktree.
worktrees() {
  herdr worktree list --cwd "$1" 2>/dev/null | python3 -c '
import json, sys
for w in json.load(sys.stdin).get("result", {}).get("worktrees", []):
    if w.get("is_linked_worktree"):
        print("\t".join([w.get("path", ""), w.get("branch") or "-", w.get("workspace_id") or ""]))' 2>/dev/null
}

# keys_help prints the keys that a person uses most.
keys_help() {
  cat <<'KEYS'
  Herdr (Mac / Linux)
    New tab, close tab           Cmd+T, Cmd+W      / Ctrl+Shift+T, Ctrl+Shift+W
    Go to anything               Cmd+K             / Ctrl+Shift+K
    Command palette              Cmd+Shift+P       / Ctrl+Shift+P
    lazygit over the pane        Cmd+Shift+G       / Ctrl+Shift+G
    Previous or next tab         Ctrl+Left, Ctrl+Right
    Previous or next workspace   Ctrl+Up, Ctrl+Down
    Next or previous pane        Alt+Up, Alt+Down
    Split right, split down      Ctrl+B V, Ctrl+B -
    Zoom the pane                Ctrl+B Z
    Leave, keep everything       Ctrl+B Q
  Shell
    Find a file, search text     ff, fif TEXT
    Jump to a folder             z NAME, zi
  Ghostty (outside Herdr)
    New tab, clear the screen    Cmd+Option+T, Cmd+Option+K / Ctrl+Alt+Shift+T
KEYS
}

# session_command prints the command that attaches to the current session.
session_command() {
  case "${HERDR_SESSION:-default}" in
    default | "") printf 'herdr' ;;
    *) printf 'herdr --session %s' "$HERDR_SESSION" ;;
  esac
}

# palette_items DIR fills PALETTE_ITEMS with the actions for DIR and the place.
palette_items() {
  local dir="$1" match file label name text state cwd kind role=""
  PALETTE_ITEMS=""
  # Projects
  if [ -n "$PAL_PANE" ]; then
    pal_add here Projects "Open this folder as its own workspace" "herdr workspace create"
    pal_add window Projects "Open this session in a new window" "$(session_command)"
  else
    pal_add folder Projects "Open this folder in Herdr" "hopen ."
    while IFS=$'\t' read -r name file; do
      pal_add "open:${name}" Projects "Open the list ${name}" "hopen ${name}"
    done < <(find_lists 2>/dev/null)
  fi
  pal_add all Projects "Open every list in the background" "hopen --all"
  pal_add lists Projects "Show every list and its state" "hopen --list"
  pal_add convert Projects "Write a herdspace.toml from a VS Code list" "hopen --convert"
  # Tasks
  if match="$(project_for_dir "$dir")"; then
    file="${match%%$'\t'*}"
    label="${match#*$'\t'}"
    while IFS=$'\t' read -r name text; do
      [ -n "$name" ] && pal_add "task:${name}" Tasks "Run the task ${name}: ${text}" "hopen --task ${name}"
    done < <(read_list "$file" items 2>/dev/null | awk -F '\036' -v l="$label" '$1 == "K" && $2 == l { print $3 "\t" $4 }')
  fi
  # Files
  command -v fzf >/dev/null 2>&1 && pal_add find Files "Find a file, and open it" "ff"
  [ -z "$PAL_PANE" ] || ! command -v fzf >/dev/null 2>&1 || pal_add quick Files "Quick open: a file in the editor of this tab" "Cmd+P, Ctrl+B F"
  command -v rg >/dev/null 2>&1 && pal_add grep Files "Search in the files, and open a result" "fif"
  if command -v nvim >/dev/null 2>&1 || [ -n "${EDITOR:-}" ]; then
    pal_add edit Files "Open this folder in the editor"
    pal_add read-md Files "Read a Markdown file, rendered"
  fi
  # Git
  if git -C "$dir" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    if command -v lazygit >/dev/null 2>&1; then
      pal_add git Git "Git status (lazygit)" "Ctrl+B D"
      [ -z "$PAL_PANE" ] || pal_add git-tab Git "Open lazygit in a new tab"
    fi
    if [ -n "$PAL_PANE" ]; then
      pal_add wt-new Git "New worktree for an agent, on a new branch" "Ctrl+B Shift+G"
      pal_add wt-open Git "Open a worktree"
      pal_add wt-list Git "Show the worktrees" "herdr worktree list"
      pal_add wt-remove Git "Remove a worktree"
    fi
  fi
  # Agents
  if [ -n "$PAL_PANE" ]; then
    while IFS=$'\t' read -r name kind state cwd; do
      [ -n "$name" ] && pal_add "agent:${name}" Agents "Go to ${kind} (${state}) in ${cwd/#"$HOME"/\~}"
    done < <(agents_sorted)
    [ -z "$(agents_sorted)" ] || pal_add explain Agents "Explain the state of an agent" "herdr agent explain"
    for kind in claude codex opencode gemini pi amp aider; do
      command -v "$kind" >/dev/null 2>&1 && pal_add "start:${kind}" Agents "Start ${kind} in a new pane"
    done
  fi
  # Layout
  if [ -n "$PAL_PANE" ]; then
    while read -r name; do
      [ "$name" = plain ] || pal_add "apply:${name}" Layout "Split the current tab with the template ${name}" "hopen --apply ${name}"
    done < <(show_templates | tail -n +2 | cut -d ' ' -f1)
    pal_add split-right Layout "Split right" "Ctrl+B V"
    pal_add split-down Layout "Split down" "Ctrl+B -"
    pal_add zoom Layout "Zoom the pane, or return" "Ctrl+B Z"
  fi
  pal_add templates Layout "Show every template" "hopen --templates"
  # Workspace and tabs
  if [ -n "$PAL_PANE" ]; then
    pal_add new-tab "Workspace and tabs" "New tab" "Ctrl+B C"
    pal_add new-ws "Workspace and tabs" "New workspace in this folder" "Ctrl+B Shift+N"
    pal_add rename-ws "Workspace and tabs" "Rename the workspace" "Ctrl+B Shift+W"
    pal_add rename-tab "Workspace and tabs" "Rename the tab" "Ctrl+B Shift+T"
    pal_add rename-pane "Workspace and tabs" "Rename the pane" "Ctrl+B Shift+P"
    pal_add close-tab "Workspace and tabs" "Close the tab" "Ctrl+B Shift+X"
  fi
  # Sessions
  if command -v herdr >/dev/null 2>&1; then
    pal_add sessions Sessions "Show the sessions" "herdr session list"
    pal_add stop-session Sessions "Stop a session" "herdr session stop"
  fi
  # Network
  pal_add ports Network "Show the ports that your programs listen on" "hopen --ports"
  # herdspace
  if command -v herdspace >/dev/null 2>&1; then
    pal_add hs-version herdspace "Show the installed and the latest version" "herdspace --version"
    pal_add hs-update herdspace "Update herdspace" "herdspace update"
    role="$(sed -n 's/^role=//p' "${XDG_DATA_HOME:-$HOME/.local/share}/herdspace/last-setup" 2>/dev/null)"
    case "$role" in client | both) pal_add hs-keys herdspace "Show or change the Ghostty keys" "herdspace keys" ;; esac
  fi
  if command -v herdr >/dev/null 2>&1; then
    [ ! -x "$HOME/.local/bin/herdr-update-check" ] || pal_add herdr-update Herdr "Check for a new Herdr version"
    pal_add herdr-reload Herdr "Reload the Herdr configuration" "herdr server reload-config"
    pal_add herdr-status Herdr "Show the state of the Herdr server" "herdr status"
  fi
  # Help
  pal_add keys-help Help "Show the keys"
  pal_add docs Help "Show the links to the cheat sheet and the docs"
}

# palette_menu prints the chosen id, a tab, and the chosen place: right, down,
# tab, or nothing for the default place of the action. In fzf, Ctrl+V, Ctrl+S,
# and Ctrl+T choose the place. In the numbered menu, a word after the name or
# the number does: "edit right", "3 down", "git tab". The recent actions come
# first. With no fzf, the numbered menu has a heading for each group.
palette_menu() {
  local items recent="" id head text i=0 last="" answer name out key place="" header
  if [ -f "$PALETTE_RECENT" ]; then
    while IFS= read -r id; do
      [ -n "$id" ] || continue
      recent="${recent}$(awk -F '\t' -v id="$id" '$1 == id { print $1 "\tRecently used\t" $3; exit }' <<<"$PALETTE_ITEMS")"$'\n'
    done <"$PALETTE_RECENT"
  fi
  items="$(printf '%s%s' "$(grep -v '^$' <<<"$recent")${recent:+$'\n'}" "$PALETTE_ITEMS" | grep -v '^$')"
  if command -v fzf >/dev/null 2>&1 && [ -n "${TERM:-}" ] && [ "${TERM}" != dumb ]; then
    header='Type to filter. Enter runs. Esc closes.'
    [ -z "$PAL_PANE" ] || header="${header}"$'\n''A program opens: Ctrl+V on the right, Ctrl+S below, Ctrl+T in a new tab.'
    out="$(fzf --delimiter '\t' --with-nth 3 --prompt '> ' --header "$header" --expect ctrl-v,ctrl-s,ctrl-t --height 100% --reverse --no-multi --tiebreak=index <<<"$items")" || true
    key="$(sed -n 1p <<<"$out")"
    id="$(sed -n 2p <<<"$out" | cut -f1)"
    [ -n "$id" ] || return 0
    case "$key" in ctrl-v) place=right ;; ctrl-s) place=down ;; ctrl-t) place=tab ;; esac
    printf '%s\t%s\n' "$id" "$place"
    return 0
  fi
  while IFS=$'\t' read -r id head text; do
    i=$((i + 1))
    if [ "$head" != "$last" ]; then
      printf '\n  %s\n' "$head" >&2
      last="$head"
    fi
    printf '  %3d) %s\n' "$i" "$text" >&2
  done <<<"$items"
  [ -z "$PAL_PANE" ] || printf '\n  A word after the action opens a program in another place: right, down, or tab.' >&2
  printf '\n  Action? Type a number or a name: ' >&2
  IFS= read -r answer </dev/tty || answer=""
  case "$answer" in
    *" right" | *" down" | *" tab")
      place="${answer##* }"
      answer="${answer% *}"
      ;;
  esac
  case "$answer" in
    "") return 0 ;;
    *[!0-9]*) name="$(awk -F '\t' -v n="$answer" '$1 == n {print $1; exit}' <<<"$items")" ;;
    *) name="$(awk -F '\t' -v n="$answer" 'NR == n {print $1; exit}' <<<"$items")" ;;
  esac
  [ -n "$name" ] || { printf '  [err]  No action %s.\n' "$answer" >&2; return 1; }
  printf '%s\t%s\n' "$name" "$place"
}

# remember ID puts ID first in the recent list. Agent ids change, so they stay out.
remember() {
  case "$1" in agent:*) return 0 ;; esac
  mkdir -p "$(dirname "$PALETTE_RECENT")" 2>/dev/null || return 0
  {
    printf '%s\n' "$1"
    [ ! -f "$PALETTE_RECENT" ] || grep -vxF -- "$1" "$PALETTE_RECENT" | head -n 4 || true
  } >"${PALETTE_RECENT}.new" 2>/dev/null && mv "${PALETTE_RECENT}.new" "$PALETTE_RECENT"
}

# palette shows the actions that fit the current folder and place, and runs
# the one that the person chooses. With --print, it prints the actions only.
palette() {
  local dir="${HERDR_ACTIVE_PANE_CWD:-$PWD}" self="$0" choice text name pick
  PAL_PANE="${HERDR_ACTIVE_PANE_ID:-${HERDR_PANE_ID:-}}"
  PAL_WS="${HERDR_ACTIVE_WORKSPACE_ID:-${HERDR_WORKSPACE_ID:-}}"
  PAL_TAB="${HERDR_ACTIVE_TAB_ID:-${HERDR_TAB_ID:-}}"
  palette_items "$dir"
  if [ "${PALETTE_PRINT:-0}" -eq 1 ]; then
    awk -F '\t' '{ print $1 "\t" $3 }' <<<"$PALETTE_ITEMS" | grep -v '^$'
    return 0
  fi
  [ -t 0 ] && [ -t 1 ] || die "hopen --palette needs a terminal."
  choice="$(palette_menu)" || exit 1
  [ -n "$choice" ] || exit 0
  PAL_PLACE="${choice#*$'\t'}"
  choice="${choice%%$'\t'*}"
  [ -n "$choice" ] || exit 0
  remember "$choice"
  cd "$dir" || die "No folder ${dir}."
  case "$choice" in
    here) herdr workspace create --cwd "$dir" --label "$(basename "$dir")" --focus >/dev/null ;;
    window)
      then_wait printf '  Open a new terminal window, connect to this machine, and run:\n\n    %s\n\n  Each window keeps its own workspace and tab. Keep the two windows on\n  different tabs while an agent runs: https://github.com/herdrdev/herdr/issues/5749\n' "$(session_command)"
      ;;
    folder) exec "$self" . ;;
    open:*) exec "$self" "${choice#open:}" ;;
    all) then_wait "$self" --all --no-attach ;;
    lists) then_wait "$self" --list ;;
    convert)
      name="$(ask_text 'The name of the VS Code list')"
      [ -z "$name" ] || then_wait "$self" --convert "$name"
      ;;
    task:*) run_at here task "$dir" "$(printf '%q --task %q' "$self" "${choice#task:}")" ;;
    find) run_at here find "$dir" "$(printf '%q --find' "$self")" ;;
    quick) DIR="$dir"; quick_open ;;
    grep)
      text="$(ask_text 'Search for')"
      [ -n "$text" ] || exit 0
      run_at here search "$dir" "$(printf '%q --grep %q' "$self" "$text")"
      ;;
    edit) run_at tab edit "$dir" "$(editor_command) ." ;;
    read-md)
      text="$(list_files 2>/dev/null | sed 's|^\./||' | grep -iE '\.(md|markdown)$' | sort)" || true
      [ -n "$text" ] || { then_wait printf '  No Markdown file in %s.\n' "$dir"; exit 0; }
      pick="$(awk '{ print $0 "\t" $0 }' <<<"$text" | choose "Markdown file")" || exit 1
      [ -n "$pick" ] || exit 0
      run_at tab "$(basename "$pick")" "$dir" "$(editor_command) -R $(printf '%q' "$pick")"
      ;;
    git) run_at here git "$dir" lazygit ;;
    git-tab) run_at tab git "$dir" lazygit ;;
    wt-new)
      name="$(ask_text 'The name of the new branch')"
      [ -n "$name" ] || exit 0
      then_wait herdr worktree create --cwd "$dir" --branch "$name" --focus
      ;;
    wt-open | wt-remove)
      pick="$(worktrees "$dir" | awk -F '\t' '{ print $1 "\t" $2 "  " $1 }' | choose "Worktree")" || exit 1
      [ -n "$pick" ] || exit 0
      if [ "$choice" = wt-open ] && [ -n "${PAL_PLACE:-}" ]; then
        run_at here "$(basename "$pick")" "$pick"
      elif [ "$choice" = wt-open ]; then
        herdr worktree open --cwd "$dir" --path "$pick" --focus >/dev/null
      else
        name="$(worktrees "$dir" | awk -F '\t' -v p="$pick" '$1 == p { print $3 }')"
        [ -n "$name" ] || { then_wait printf '  The worktree %s has no workspace. Open it first, then remove it.\n' "$pick"; exit 0; }
        confirm "Remove the worktree ${pick}? Changes that you did not commit are lost." || exit 0
        then_wait herdr worktree remove --workspace "$name"
      fi
      ;;
    wt-list) then_wait sh -c 'herdr worktree list --cwd "$1" | python3 -c "import json,sys; [print(\"  \"+(w.get(\"branch\") or \"-\")+\"  \"+w.get(\"path\",\"\")) for w in json.load(sys.stdin).get(\"result\",{}).get(\"worktrees\",[])]"' _ "$dir" ;;
    agent:*) herdr agent focus "${choice#agent:}" >/dev/null ;;
    explain)
      pick="$(agents_sorted | awk -F '\t' '{ print $1 "\t" $2 " (" $3 ")  " $4 }' | choose "Agent")" || exit 1
      [ -z "$pick" ] || then_wait herdr agent explain "$pick"
      ;;
    start:*) run_at right "${choice#start:}" "$dir" "${choice#start:}" ;;
    apply:*) then_wait "$self" --apply "${choice#apply:}" ;;
    split-right) split_run right "$dir" ;;
    split-down) split_run down "$dir" ;;
    zoom) herdr pane zoom --pane "$PAL_PANE" --toggle >/dev/null ;;
    templates) then_wait "$self" --templates ;;
    new-tab) herdr tab create --workspace "$PAL_WS" --cwd "$dir" --focus >/dev/null ;;
    new-ws) herdr workspace create --cwd "$dir" --focus >/dev/null ;;
    rename-ws | rename-tab | rename-pane)
      name="$(ask_text 'The new name')"
      [ -n "$name" ] || exit 0
      case "$choice" in
        rename-ws) herdr workspace rename "$PAL_WS" "$name" >/dev/null ;;
        rename-tab) herdr tab rename "$PAL_TAB" "$name" >/dev/null ;;
        rename-pane) herdr pane rename "$PAL_PANE" "$name" >/dev/null ;;
      esac
      ;;
    close-tab) confirm "Close this tab and end the programs in it?" && herdr tab close "$PAL_TAB" >/dev/null ;;
    sessions) then_wait herdr session list ;;
    stop-session)
      pick="$(herdr session list 2>/dev/null | awk 'NR > 1 && $2 == "running" { print $1 "\t" $1 }' | choose "Session")" || exit 1
      [ -n "$pick" ] || exit 0
      text="Stop the session ${pick}, and end every program in it?"
      [ "$pick" != "${HERDR_SESSION:-default}" ] || text="Stop the session ${pick}, the one that you use now, and end every program in it?"
      confirm "$text" || exit 0
      if [ "$pick" = default ]; then then_wait herdr server stop; else then_wait herdr session stop "$pick"; fi
      ;;
    ports) then_wait "$self" --ports ;;
    hs-version) then_wait herdspace --version ;;
    hs-update) if [ -n "$PAL_PANE" ]; then new_tab_run update "$HOME" "herdspace update"; else exec herdspace update; fi ;;
    hs-keys)
      herdspace keys
      pick="$(printf 'normal\tnormal: Cmd+T, Cmd+W, and Cmd+K stay with Ghostty\nherdr\therdr: Cmd+T, Cmd+W, and Cmd+K go to Herdr\n' | choose "Keys")" || exit 1
      [ -n "$pick" ] || exit 0
      if [ -n "$PAL_PANE" ]; then new_tab_run keys "$HOME" "herdspace keys ${pick}"; else exec herdspace keys "$pick"; fi
      ;;
    herdr-update) then_wait "$HOME/.local/bin/herdr-update-check" --now ;;
    herdr-reload) then_wait herdr server reload-config ;;
    herdr-status) then_wait herdr status ;;
    keys-help) then_wait keys_help ;;
    docs) then_wait printf '  The cheat sheet:  https://github.com/MussaCharles/herdspace/blob/main/docs/cheat-sheet.md\n  The docs:         https://github.com/MussaCharles/herdspace/blob/main/docs/README.md\n' ;;
  esac
}

case "$ACTION" in
  completion) completion_script "$SHELL_NAME"; exit 0 ;;
  task) run_task; exit 0 ;;
  ports) show_ports; exit 0 ;;
  palette) palette; exit 0 ;;
  find) DIR="${HERDR_ACTIVE_PANE_CWD:-$PWD}"; find_file ;;
  quick) DIR="${HERDR_ACTIVE_PANE_CWD:-$PWD}"; quick_open ;;
  grep) DIR="${HERDR_ACTIVE_PANE_CWD:-$PWD}"; grep_files ;;
  complete)
    # The completion scripts call this. It prints one name on each line.
    case "$COMPLETE_WHAT" in
      lists) find_lists 2>/dev/null | cut -f1 ;;
      templates) show_templates | tail -n +2 | cut -d ' ' -f1 ;;
      tasks)
        match="$(project_for_dir "$PWD")" || exit 0
        read_list "${match%%$'\t'*}" items 2>/dev/null | awk -F '\036' -v l="${match#*$'\t'}" '$1 == "K" && $2 == l { print $3 }'
        ;;
    esac
    exit 0
    ;;
  list) show_lists; exit 0 ;;
  convert) convert_list; exit 0 ;;
  templates) show_templates; exit 0 ;;
  apply) apply_here; exit 0 ;;
esac

if [ -n "$TEMPLATE_FLAG" ] && ! template_exists "$TEMPLATE_FLAG"; then
  die "No template named ${TEMPLATE_FLAG}. Run hopen --templates."
fi

if [ "$ACTION" = all ]; then
  [ -z "$SESSION" ] || valid_name "$SESSION" || die "A session name can use only letters, numbers, dots, dashes, and underscores."
  open_all
  exit 0
fi

# pick_list lets the person choose a list when hopen gets no name in a
# terminal.
pick_list() {
  local lists name file
  lists="$(find_lists)"
  [ -n "$lists" ] || die "No project lists. Create ~/my-projects/herdspace.toml, or run hopen . in a folder."
  SESSION="$(while IFS=$'\t' read -r name file; do printf '%s\t%-22s %s\n' "$name" "$name" "$(short_path "$file")"; done <<<"$lists" | choose "Open which list")" || exit 1
  [ -n "$SESSION" ] || exit 0
}

if [ -z "$SESSION" ] && [ -t 0 ] && [ -t 1 ]; then
  if [ "${HERDR_ENV:-}" = "1" ] && [ "$ATTACH" -eq 1 ]; then
    die "You are in a Herdr pane. Press ctrl+b, then q, and run this command again."
  fi
  pick_list
fi

[ -n "$SESSION" ] || { usage >&2; exit 2; }

# use_list_file FILE opens the list in FILE. The same rule as find_lists: a list
# outside the usual places cannot take the session of another list. Its
# commands and values still need approval.
use_list_file() {
  local list="$1" owner
  LIST_FILE="$list"
  SESSION="$(read_list "$list" session)" || die "Could not read ${list}."
  owner="$(find_list_for "$SESSION" 2>/dev/null)"
  if [ -n "$owner" ] && [ "$owner" != "$list" ]; then
    die "$(short_path "$list") uses the session ${SESSION}, which $(short_path "$owner") has. Give the list another session name."
  fi
}

# open_folder handles "hopen <folder>". It uses the list in the folder, if the
# folder has one: herdspace.toml, <folder>.code-workspace, or the only
# .code-workspace file. Else the session and its one workspace get the folder name.
open_folder() {
  local path name list others=()
  path="$(cd "$SESSION" 2>/dev/null && pwd -P)" || die "No folder ${SESSION}."
  [[ "$path" != *[[:cntrl:]]* ]] || die "The folder name has a control character."
  name="$(basename "$path")"
  for list in "${path}/herdspace.toml" "${path}/${name}.code-workspace"; do
    if [ -f "$list" ]; then
      use_list_file "$list"
      return 0
    fi
  done
  for list in "$path"/*.code-workspace; do
    [ -f "$list" ] && others+=("$list")
  done
  if [ "${#others[@]}" -eq 1 ]; then
    use_list_file "${others[0]}"
    return 0
  fi
  if [ "${#others[@]}" -gt 1 ]; then
    die "The folder has more than one VS Code workspace file. Open one of them, for example: hopen $(basename "${others[0]}")"
  fi
  FOLDER="$path"
  # A session name uses letters, numbers, dots, dashes, and underscores only.
  SESSION="$(printf '%s' "$name" | tr -c 'A-Za-z0-9._-' '-')"
  [ "$SESSION" != "." ] && [ "$SESSION" != ".." ] || SESSION="-"
  list="$(find_list_for "$SESSION" 2>/dev/null)"
  [ -z "$list" ] || warn "The list $(short_path "$list") uses the session ${SESSION}. hopen adds the folder to that session."
}

# "hopen <file>" opens a list file by its path, for example a VS Code workspace
# file whose name is not the name of its folder.
if [ -f "$SESSION" ]; then
  case "$SESSION" in
    *.code-workspace | *herdspace.toml)
      [ -z "$LIST_FILE" ] || die "Give the list file once: as the argument or with --file."
      [[ "$SESSION" != *[[:cntrl:]]* ]] || die "The file name has a control character."
      use_list_file "$(cd "$(dirname "$SESSION")" && pwd -P)/$(basename "$SESSION")"
      ;;
  esac
fi

case "$SESSION" in
  . | .. | */*)
    [ -z "$LIST_FILE" ] || die "Use --file with a session name, not with a folder."
    open_folder
    ;;
esac

valid_name "$SESSION" || die "A session name can use only letters, numbers, dots, dashes, and underscores."

if [ "${HERDR_ENV:-}" = "1" ] && [ "$ATTACH" -eq 1 ]; then
  die "You are in a Herdr pane. Press ctrl+b, then q, and run this command again."
fi

if [ -z "$LIST_FILE" ] && [ -z "$FOLDER" ]; then
  LIST_FILE="$(find_list_for "$SESSION")"
fi

if [ -z "$FOLDER" ] && { [ -z "$LIST_FILE" ] || [ ! -f "$LIST_FILE" ]; }; then
  no_list_error "$SESSION"
fi

prepare_session

if [ "$ATTACH" -eq 1 ]; then
  attach_session
fi
