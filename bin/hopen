#!/usr/bin/env bash
# hopen opens all the projects of a list in one named Herdr session, with one
# Herdr workspace for each folder, and then attaches to it. A list is a VS Code
# workspace file or a herdspace.toml file. docs/hopen.md explains both.
#
# Run it again at any time. It starts a stopped session, adds only the folders
# that have no workspace, and closes nothing. The first workspace has the name
# of the session and opens the folder that holds the list file.
#
# A template splits a new workspace into named panes and starts a program in
# each. After a stopped session starts again, hopen starts those programs again.
#
# Usage: hopen <session> [--template NAME] [--file PATH] [--no-attach] [--trust]
#        hopen                   In a terminal, choose a list from a menu.
#        hopen <folder>          Open a folder, for example "hopen .". A list in
#                                the folder wins. Else one workspace, no list.
#        hopen --all [session] [--template NAME]
#        hopen --list            Show every list and its state.
#        hopen --templates       Show every template.
#        hopen --apply NAME      Split the current tab with a template.
#        hopen --convert NAME    Write ~/NAME/herdspace.toml from the VS Code list NAME.
#        hopen --completion zsh|bash   Print a shell completion script.
#        hopen --task [NAME]     Run a task of the project of the current folder.
#
# A list can run commands (on-open and tab commands) and set environment
# values. hopen asks before it uses them the first time, and again after the
# list changes. With no terminal, it uses them only with --trust.
set -euo pipefail

# The release script writes the release tag here.
HOPEN_VERSION="dev"
SESSION=""
LIST_FILE=""
ATTACH=1
ACTION="one"
TEMPLATE_FLAG=""
APPLY_NAME=""
SHELL_NAME=""
COMPLETE_WHAT=""
TEMPLATE_DIR="${HOPEN_TEMPLATES:-${XDG_CONFIG_HOME:-$HOME/.config}/hopen/templates}"
STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/hopen"
STARTED=0
# GUARD_PAIRS holds one "pane id<TAB>name" line for each pane that a template named.
GUARD_PAIRS=""
# GUARD_TABS holds one "root pane id<TAB>name" line for each tab that a list named.
GUARD_TABS=""
# ENV_ARGS holds one "--env KEY=VALUE" pair for each environment value of the
# project that hopen opens now. Each new workspace, tab, and pane gets them.
ENV_ARGS=()
TRUST_FLAG=0
TASK_NAME=""
# FOLDER is set for "hopen <folder>" when the folder has no list of its own.
FOLDER=""

usage() {
  echo "Usage: hopen <session> [--template NAME] [--file PATH] [--no-attach] [--trust]"
  echo "       hopen            (in a terminal: choose a list from a menu)"
  echo "       hopen <folder>   (for example: hopen .)"
  echo "       hopen --all [session] [--template NAME]"
  echo "       hopen --list"
  echo "       hopen --templates"
  echo "       hopen --apply NAME"
  echo "       hopen --convert NAME"
  echo "       hopen --completion zsh|bash"
  echo "       hopen --task [NAME]"
  echo "       hopen --version"
}
# short_path PATH shows a path in the home folder as ~/... The ~ is in a
# variable, because bash 5 expands a ~ in the replacement text.
short_path() { local tilde='~'; printf '%s' "${1/#$HOME/$tilde}"; }
warn() { printf '  [warn] %s\n' "$*" >&2; }
die() { printf '  [err]  %s\n' "$*" >&2; exit 1; }

while [ "$#" -gt 0 ]; do
  case "$1" in
    --file | --template | --apply | --convert | --completion | --complete)
      [ "$#" -ge 2 ] || { usage >&2; exit 2; }
      case "$1" in
        --file) LIST_FILE="$2" ;;
        --template) TEMPLATE_FLAG="$2" ;;
        --apply) ACTION="apply"; APPLY_NAME="$2" ;;
        --convert) ACTION="convert"; SESSION="$2" ;;
        --completion) ACTION="completion"; SHELL_NAME="$2" ;;
        --complete) ACTION="complete"; COMPLETE_WHAT="$2" ;;
      esac
      shift 2
      ;;
    --task)
      ACTION="task"
      shift
      if [ "$#" -gt 0 ] && [ "${1#-}" = "$1" ]; then
        TASK_NAME="$1"
        shift
      fi
      ;;
    --no-attach) ATTACH=0; shift ;;
    --trust) TRUST_FLAG=1; shift ;;
    --all) ACTION="all"; shift ;;
    --list) ACTION="list"; shift ;;
    --templates) ACTION="templates"; shift ;;
    --version) echo "hopen ${HOPEN_VERSION}"; exit 0 ;;
    -h | --help) usage; exit 0 ;;
    -*) usage >&2; exit 2 ;;
    *)
      [ -z "$SESSION" ] || { usage >&2; exit 2; }
      SESSION="$1"
      shift
      ;;
  esac
done

valid_name() {
  case "$1" in
    "" | *[!A-Za-z0-9._-]*) return 1 ;;
    *) return 0 ;;
  esac
}

# ---------- shell completion

# completion_script SHELL prints a completion script for zsh or bash. It asks
# "hopen --complete lists|templates" for the names, so that they stay current.
completion_script() {
  case "$1" in
    zsh)
      cat <<'ZSH'
#compdef hopen
_hopen() {
  local -a options
  options=(--all --list --templates --apply --convert --file --template --no-attach --trust --task --completion --version --help)
  case "${words[CURRENT-1]}" in
    --template | --apply) compadd -- ${(f)"$(hopen --complete templates 2>/dev/null)"}; return ;;
    --convert) compadd -- ${(f)"$(hopen --complete lists 2>/dev/null)"}; return ;;
    --task) compadd -- ${(f)"$(hopen --complete tasks 2>/dev/null)"}; return ;;
    --file) _files; return ;;
    --completion) compadd zsh bash; return ;;
  esac
  case "$PREFIX" in
    -*) compadd -- $options ;;
    */* | .*) _files -/ ;;
    *) compadd -- ${(f)"$(hopen --complete lists 2>/dev/null)"} ;;
  esac
}
compdef _hopen hopen
ZSH
      ;;
    bash)
      cat <<'BASH'
# This works with bash 3.2, the bash of macOS, which has no mapfile.
_hopen() {
  local cur="${COMP_WORDS[COMP_CWORD]}" prev="${COMP_WORDS[COMP_CWORD-1]}" words="" IFS=$'\n'
  case "$prev" in
    --template | --apply) words="$(hopen --complete templates 2>/dev/null)" ;;
    --convert) words="$(hopen --complete lists 2>/dev/null)" ;;
    --task) words="$(hopen --complete tasks 2>/dev/null)" ;;
    --completion) words=$'zsh\nbash' ;;
    --file) COMPREPLY=($(compgen -f -- "$cur")); return ;;
    *)
      case "$cur" in
        -*) words=$'--all\n--list\n--templates\n--apply\n--convert\n--file\n--template\n--no-attach\n--trust\n--task\n--completion\n--version\n--help' ;;
        */* | .*) COMPREPLY=($(compgen -d -- "$cur")); return ;;
        *) words="$(hopen --complete lists 2>/dev/null)" ;;
      esac
      ;;
  esac
  COMPREPLY=($(compgen -W "$words" -- "$cur"))
}
complete -o filenames -F _hopen hopen
BASH
      ;;
    *) die "hopen --completion needs zsh or bash." ;;
  esac
}

# ---------- templates

template_file() { printf '%s/%s.layout' "$TEMPLATE_DIR" "$1"; }

# template_exists exits 0 for a template file, and for "plain", which means no
# panes. A name is letters, numbers, "-", and "_", so it cannot leave the folder.
template_exists() {
  [ "$1" = plain ] && return 0
  [[ "$1" =~ ^[A-Za-z0-9][A-Za-z0-9_-]*$ ]] || return 1
  [ -f "$(template_file "$1")" ]
}

template_lines() { grep -vE '^[[:space:]]*(#|$)' "$(template_file "$1")"; }

show_templates() {
  local file name text
  printf '%-12s %s\n' TEMPLATE DESCRIPTION
  printf '%-12s %s\n' plain "One pane with a shell. This is the default."
  for file in "$TEMPLATE_DIR"/*.layout; do
    [ -f "$file" ] || continue
    name="$(basename "$file" .layout)"
    text="$(sed -n "1s/^# *${name}: *//p" "$file")"
    printf '%-12s %s\n' "$name" "${text:-}"
  done
}

json_get() { python3 -I -c "import json,sys; d=json.load(sys.stdin); print(eval(sys.argv[1], {'d': d}))" "$1"; }

# apply_template NAME ROOT_PANE splits from ROOT_PANE and starts each program.
apply_template() {
  local name="$1" root="$2" made pane from direction size command id source
  made="$(printf '%s\t%s' "" "")"
  while read -r pane from direction size command; do
    if [ "$from" = "-" ]; then
      id="$root"
    else
      source="$(awk -F '\t' -v n="$from" '$1 == n {print $2}' <<<"$made")"
      if [ -z "$source" ]; then
        warn "Template ${name}: the pane ${from} comes later or does not exist."
        continue
      fi
      id="$(herdr pane split "$source" --direction "$direction" --ratio "$size" --no-focus ${ENV_ARGS[@]+"${ENV_ARGS[@]}"} | json_get "d['result']['pane']['pane_id']")"
    fi
    herdr pane rename "$id" "$pane" >/dev/null
    GUARD_PAIRS="${GUARD_PAIRS}${id}"$'\t'"${pane}"$'\n'
    made="${made}
$(printf '%s\t%s' "$pane" "$id")"
    if [ -n "$command" ] && [ "$command" != "-" ]; then
      herdr pane run "$id" "$command" >/dev/null
    fi
  done < <(template_lines "$name")
}

# guard_names keeps the template pane names and the tab names of a list for a
# short time. A plugin such as Auto Title names panes and tabs too. It keeps a name that you chose, but after a
# restart it can forget that choice, because every session writes its choices
# to one shared file, with pane IDs that repeat across sessions. So for
# HOPEN_GUARD_SECONDS (default 30), a background job puts back each template
# name that changed. The plugin then counts the name as one that you chose
# again. HOPEN_GUARD_SECONDS=0 turns the guard off.
guard_names() {
  local seconds="${HOPEN_GUARD_SECONDS:-30}"
  [ -n "$GUARD_PAIRS$GUARD_TABS" ] && [ "$seconds" != 0 ] || return 0
  printf '%s\036%s' "$GUARD_PAIRS" "$GUARD_TABS" | nohup python3 -I -c '
import json, subprocess, sys, time
panes_text, _, tabs_text = sys.stdin.read().partition("\x1e")
pairs = [line.split("\t", 1) for line in panes_text.split("\n") if "\t" in line]
# A tab is found by its first pane, because a tab create answer has that pane.
tabs = [line.split("\t", 1) for line in tabs_text.split("\n") if "\t" in line]
end = time.time() + float(sys.argv[1])

def herdr(*args):
    out = subprocess.run(["herdr", *args], capture_output=True, text=True, timeout=5).stdout
    return json.loads(out)["result"]

while (pairs or tabs) and time.time() < end:
    time.sleep(0.5)
    try:
        panes = herdr("pane", "list")["panes"]
        labels = {p["pane_id"]: p.get("label") or "" for p in panes}
        tab_of = {p["pane_id"]: (p["workspace_id"], p["tab_id"]) for p in panes}
        tab_labels = {}
        for workspace in {tab_of[pane][0] for pane, _ in tabs if pane in tab_of}:
            for tab in herdr("tab", "list", "--workspace", workspace)["tabs"]:
                tab_labels[tab["tab_id"]] = tab.get("label") or ""
    except Exception:
        continue
    pairs = [(pane, name) for pane, name in pairs if pane in labels]
    for pane, name in pairs:
        if labels[pane] != name:
            subprocess.run(["herdr", "pane", "rename", pane, name], capture_output=True, timeout=5)
    tabs = [(pane, name) for pane, name in tabs if pane in tab_of and tab_of[pane][1] in tab_labels]
    for pane, name in tabs:
        tab = tab_of[pane][1]
        if tab_labels[tab] != name:
            subprocess.run(["herdr", "tab", "rename", tab, name], capture_output=True, timeout=5)
' "$seconds" >/dev/null 2>&1 &
  disown
  GUARD_PAIRS=""
  GUARD_TABS=""
}

# ---------- project lists

# A list is a VS Code workspace file, ~/<name>.code-workspace or
# ~/<name>/<name>.code-workspace, or a herdspace file, ~/<name>/herdspace.toml.
# The session has the name of the file or the folder, unless the list sets one.

# read_list FILE WHAT prints facts about one list. WHAT is one of:
#   session  the session name
#   items    one line for each workspace and each extra tab. The fields are
#            separated by the byte 0x1e (RS below), which is not white space,
#            so that bash keeps each field in its place:
#            R RS label RS path RS template RS on_open RS env   (the parent workspace)
#            P RS label RS path RS template RS on_open RS env   (a project)
#            T RS label RS tab name RS template RS command
#            F RS label RS file RS names RS env  (the values of an env file;
#                                                 it comes before its R or P line)
#            K RS label RS task name RS command   (a task; it comes after its R or P line)
#            W RS message                                       (a warning)
#            env is KEY=VALUE items, separated by the byte 0x1f. An empty
#            field is "-". No field holds a control character.
read_list() {
  python3 -I - "$1" "$2" "${TEMPLATE_FLAG:-}" <<'PY'
import json, os, re, sys, unicodedata

path, what, forced = sys.argv[1:4]
path = os.path.abspath(path)
base = os.path.dirname(path)


# Unicode categories that a list must not show or pass on: control characters
# (for example ESC), format characters (for example bidi marks that reorder
# text), and line or paragraph separators.
HIDDEN = ("Cc", "Cf", "Zl", "Zp", "Cs", "Co")

def has_hidden(value):
    return any(unicodedata.category(c) in HIDDEN for c in str(value))

def clean(value):
    # Tabs and new lines become spaces. Every other hidden character becomes
    # "?", so that a list cannot add a line or change what the approval
    # question shows.
    text = str(value).replace("\t", " ").replace("\n", " ").replace("\r", " ")
    return "".join("?" if unicodedata.category(c) in HIDDEN else c for c in text).strip()

def emit(kind, *fields, env=None):
    # Each output line goes through here, so each field is clean, and an
    # empty field is "-". The environment values are a list of clean
    # KEY=VALUE items.
    parts = [kind] + [clean(value) or "-" for value in fields]
    if env is not None:
        parts.append("\x1f".join(env) if env else "-")
    print("\x1e".join(parts))

def warn(text):
    emit("W", text)

if has_hidden(base):
    sys.exit("The folder of the list has a control character in its name.")

TEMPLATE_NAME = re.compile(r"[A-Za-z0-9][A-Za-z0-9_-]*")

def template_name(value, where):
    # A template is a file in the templates folder of the person. A name with
    # "/" or ".." could point at a file from somewhere else, so it is refused.
    if value is None or value == "":
        return None
    if not isinstance(value, str) or not TEMPLATE_NAME.fullmatch(value):
        warn(f"{where}: the template name {clean(value)} is not valid. hopen uses the default.")
        return None
    return value

def field(value):
    return clean(value) or "-"

def list_path(raw):
    # A path with a hidden character could break the output lines.
    if has_hidden(raw):
        return None
    return os.path.normpath(os.path.join(base, os.path.expanduser(str(raw))))

if os.path.basename(path) == "herdspace.toml":
    if sys.version_info < (3, 11):
        sys.exit("herdspace.toml needs Python 3.11 or later. Install a newer Python, for example with: brew install python")
    import tomllib
    with open(path, "rb") as handle:
        try:
            data = tomllib.load(handle)
        except tomllib.TOMLDecodeError as error:
            sys.exit(f"{path}: {error}")
    session = data.get("session") or os.path.basename(base)
    default = data.get("template", "plain")
    parent = data.get("parent_workspace", True)
    projects = []
    for entry in data.get("project", []):
        if not isinstance(entry, dict) or "path" not in entry:
            warn("A [[project]] entry has no path, so hopen skips it.")
            continue
        projects.append({
            "path": entry["path"],
            "name": entry.get("name"),
            "template": entry.get("template"),
            "on_open": entry.get("on_open", ""),
            "tabs": entry.get("tabs", []),
            "env": entry.get("env", {}),
            "env_file": entry.get("env_file"),
            "tasks": entry.get("tasks", {}),
        })
    parent_open = data.get("on_open", "")
    parent_tasks = data.get("tasks", {})
    parent_env = data.get("env", {})
    parent_env_file = data.get("env_file")
    parent_template = data.get("parent_template")
else:
    with open(path, encoding="utf-8") as handle:
        text = handle.read()
    # VS Code accepts comment lines and trailing commas.
    text = re.sub(r"^\s*//.*$", "", text, flags=re.M)
    text = re.sub(r",(\s*[\]}])", r"\1", text)
    try:
        data = json.loads(text)
    except ValueError as error:
        sys.exit(f"{path}: {error}")
    settings = data.get("settings", {}) or {}
    session = settings.get("hopen.session") or os.path.basename(path)[: -len(".code-workspace")]
    default = settings.get("hopen.template", "plain")
    parent = settings.get("hopen.parentWorkspace", True)
    per_template = settings.get("hopen.templates", {}) or {}
    per_open = settings.get("hopen.onOpen", {}) or {}
    per_tabs = settings.get("hopen.tabs", {}) or {}
    per_env = settings.get("hopen.env", {}) or {}
    per_env_file = settings.get("hopen.envFile", {}) or {}
    per_tasks = settings.get("hopen.tasks", {}) or {}
    projects = []
    for folder in data.get("folders", []):
        if not isinstance(folder, dict) or "path" not in folder:
            warn("A folder entry has no path, so hopen skips it.")
            continue
        full = os.path.normpath(os.path.join(base, os.path.expanduser(folder["path"])))
        label = folder.get("name") or os.path.basename(full)
        projects.append({
            "path": folder["path"],
            "name": label,
            "template": per_template.get(label),
            "on_open": per_open.get(label, ""),
            "tabs": per_tabs.get(label, []),
            "env": per_env.get(label, {}),
            "env_file": per_env_file.get(label),
            "tasks": per_tasks.get(label, {}),
        })
    parent_tasks = per_tasks.get(session, {})
    parent_open = per_open.get(session, "")
    parent_env = per_env.get(session, {})
    parent_env_file = per_env_file.get(session)
    parent_template = per_template.get(session)

if not isinstance(parent, bool):
    warn("The parent workspace setting must be true or false. hopen uses true.")
    parent = True

if what == "session":
    if not clean(session):
        sys.exit("The session name of the list is empty.")
    print(clean(session))
    sys.exit(0)

default = template_name(default, "template") or "plain"

def template(value, where=""):
    return forced or template_name(value, where or "template") or default

def env_items(label, values):
    if not values:
        return []
    if not isinstance(values, dict):
        warn(f"{label}: env must be a map of names to values. hopen skips it.")
        return []
    items = []
    for key, value in values.items():
        if not re.fullmatch(r"[A-Za-z_][A-Za-z0-9_]*", str(key)) or isinstance(value, (dict, list)):
            warn(f"{label}: the environment value {key} is not valid. hopen skips it.")
            continue
        if isinstance(value, bool):
            value = "true" if value else "false"
        items.append(f"{key}={clean(value)}")
    return items

ENV_NAME = re.compile(r"[A-Za-z_][A-Za-z0-9_]*")

# An env file cannot set a name that makes a shell or a program run code.
# The approval question shows each other value, but it hides a value whose
# name looks like a secret.
RISKY = re.compile(r"PATH|HOME|SHELL|ENV|BASH_ENV|ZDOTDIR|PROMPT_COMMAND|PS[0-4]|IFS|TERM|TMPDIR"
                   r"|LD_.*|DYLD_.*|NODE_.*|NPM_CONFIG_.*|PYTHON.*|PERL.*|RUBY.*|GEM_.*|JAVA_.*|_JAVA_.*"
                   r"|GIT_.*|SSH_.*|XDG_.*|LESS.*|.*_COMMAND|.*_OPTIONS|.*_OPTS|.*PAGER|.*ASKPASS|.*EDITOR"
                   r"|VISUAL|BROWSER|HERDR_.*|HOPEN_.*", re.I)
SECRET = re.compile(r".*(TOKEN|SECRET|PASSWORD|PASSWD|PASS|PWD|KEY|CREDENTIAL|AUTH|PRIVATE|SESSION|COOKIE|DSN).*", re.I)

def env_file(label, raw, folder):
    # env_file reads a .env file: KEY=VALUE lines, with "#" comments, an
    # optional "export ", and optional quotes. A relative path starts at the
    # folder of the project. It emits one F line before the R or P line.
    if raw is None or raw == "":
        return
    if not isinstance(raw, str) or has_hidden(raw):
        warn(f"{label}: env_file must be a path. hopen skips it.")
        return
    file = os.path.normpath(os.path.join(folder, os.path.expanduser(raw)))
    try:
        with open(file, encoding="utf-8") as handle:
            lines = handle.read().split("\n")
    except (OSError, UnicodeDecodeError):
        warn(f"{label}: hopen cannot read the env file {clean(file)}. hopen skips it.")
        return
    items, names = [], []
    for number, line in enumerate(lines, 1):
        line = line.strip()
        if not line or line.startswith("#"):
            continue
        if line.startswith("export "):
            line = line[len("export "):].lstrip()
        key, sep, value = line.partition("=")
        key, value = key.strip(), value.strip()
        if not sep or not ENV_NAME.fullmatch(key):
            warn(f"{label}: line {number} of {clean(file)} is not KEY=VALUE. hopen skips it.")
            continue
        if len(value) >= 2 and value[0] == value[-1] and value[0] in "\"'":
            value = value[1:-1]
        elif " #" in value:
            value = value.split(" #", 1)[0].rstrip()
        if RISKY.fullmatch(key):
            warn(f"{label}: an env file cannot set {key}, because it can run code. Put it in env, where the approval question shows it.")
            continue
        items.append(f"{key}={clean(value)}")
        names.append(f"{key}=(hidden)" if SECRET.fullmatch(key) else f"{key}={clean(value)}")
    if items:
        emit("F", label, file, ", ".join(names), env=items)

TASK_NAME = re.compile(r"[A-Za-z0-9][A-Za-z0-9_.:-]*")

def tasks(label, values):
    # A task is a name and a command, like a task of tasks.json in VS Code.
    if not values:
        return
    if not isinstance(values, dict):
        warn(f"{label}: tasks must be a map of names to commands. hopen skips them.")
        return
    for name, command in values.items():
        if not TASK_NAME.fullmatch(str(name)) or not isinstance(command, str) or not clean(command):
            warn(f"{label}: the task {clean(name)} is not valid. A task is a name of letters, numbers, and . _ : -, and a command.")
            continue
        emit("K", label, name, command)

if parent:
    if not clean(session):
        sys.exit("The session name of the list is empty.")
    env_file(clean(session), parent_env_file, base)
    emit("R", session, base, template(parent_template, clean(session)), field(parent_open), env=env_items(clean(session), parent_env))
    tasks(clean(session), parent_tasks)
for project in projects:
    full = list_path(project["path"])
    if full is None:
        warn(f"A project path has a control character, so hopen skips it: {project['path']}")
        continue
    label = clean(project["name"] or os.path.basename(full))
    if not label or label == "-":
        warn(f"A project has an empty name, so hopen skips it: {project['path']}")
        continue
    env_file(label, project["env_file"], full)
    emit("P", label, full, template(project["template"], label), field(project["on_open"]), env=env_items(label, project["env"]))
    tasks(label, project["tasks"])
    tabs = project["tabs"]
    if not isinstance(tabs, list):
        warn(f"{label}: tabs must be a list. hopen skips them.")
        continue
    for tab in tabs:
        if not isinstance(tab, dict) or clean(tab.get("name") or "") in ("", "-"):
            warn(f"{label}: each tab needs a name. hopen skips one tab.")
            continue
        emit("T", label, tab["name"], template_name(tab.get("template"), f"{label}, tab {clean(tab['name'])}") or "plain", field(tab.get("run", "")))
PY
}

# find_lists prints one "session<TAB>file" line for each project list.
#
# A list can name its session with "session" or "hopen.session". That name
# never takes over a list whose own file or folder has the name of the session:
# a list that only claims a name gets a warning, and hopen skips it. If two
# lists only claim one name, hopen skips both. If a herdspace.toml and a VS Code
# list both have the name, hopen uses herdspace.toml, and it prints a warning.
find_lists() {
  local file name session
  {
    for file in "$HOME"/*/herdspace.toml; do
      [ -f "$file" ] || continue
      name="$(basename "$(dirname "$file")")"
      session="$(read_list "$file" session 2>&1)" || { warn "Skipped ${file}. ${session}"; continue; }
      valid_name "$session" && printf '%s\t%s\t%s\n' "$session" "$file" "$([ "$session" = "$name" ] && echo own || echo claimed)"
    done
    for file in "$HOME"/*.code-workspace "$HOME"/*/*.code-workspace; do
      [ -f "$file" ] || continue
      name="$(basename "$file" .code-workspace)"
      case "$file" in
        "${HOME}/${name}.code-workspace" | "${HOME}/${name}/${name}.code-workspace") ;;
        *) continue ;;
      esac
      session="$(read_list "$file" session 2>&1)" || { warn "Skipped ${file}. ${session}"; continue; }
      valid_name "$session" && printf '%s\t%s\t%s\n' "$session" "$file" "$([ "$session" = "$name" ] && echo own || echo claimed)"
    done
  } | awk -F '\t' '
    { order[NR] = $1; file[NR] = $2; kind[NR] = $3; count[$1 SUBSEP $3]++ }
    END {
      for (i = 1; i <= NR; i++) {
        s = order[i]
        if (done[s]) continue
        if (count[s SUBSEP "own"] > 0) {
          if (kind[i] != "own") continue
          done[s] = 1
          print s "\t" file[i]
          for (j = 1; j <= NR; j++) {
            if (j == i || order[j] != s) continue
            if (kind[j] == "own") printf "  [warn] Session %s has two lists. hopen uses %s.\n", s, file[i] > "/dev/stderr"
            else printf "  [warn] %s claims the session %s, which %s has. hopen skips it.\n", file[j], s, file[i] > "/dev/stderr"
          }
        } else if (count[s SUBSEP "claimed"] > 1) {
          done[s] = 1
          printf "  [warn] Two lists claim the session %s. hopen skips both. Give one another name:\n", s > "/dev/stderr"
          for (j = 1; j <= NR; j++) if (order[j] == s) printf "         %s\n", file[j] > "/dev/stderr"
        } else {
          done[s] = 1
          print s "\t" file[i]
        }
      }
    }'
}

find_list_for() {
  find_lists | awk -F '\t' -v n="$1" '$1 == n {print $2}'
}

# ---------- sessions

session_answers() {
  local output
  output="$(HERDR_SESSION="$SESSION" herdr workspace list 2>/dev/null)" || return 1
  [[ "$output" == *workspace_list* ]]
}

start_session() {
  HERDR_SESSION="$SESSION" nohup herdr server >/dev/null 2>&1 &
  disown
  STARTED=1
  for _ in $(seq 1 40); do
    session_answers && return 0
    sleep 0.25
  done
  die "The session ${SESSION} did not start."
}

# workspaces prints one "label<TAB>workspace id" line for each workspace.
workspaces() {
  HERDR_SESSION="$SESSION" herdr workspace list | python3 -I -c '
import json, sys
for w in json.load(sys.stdin)["result"]["workspaces"]:
    print(w["label"], w["workspace_id"], sep="\t")
'
}

# panes_of WORKSPACE prints one "label<TAB>pane id" line for each pane.
panes_of() {
  HERDR_SESSION="$SESSION" herdr pane list | python3 -I -c '
import json, sys
for p in json.load(sys.stdin)["result"]["panes"]:
    if p["workspace_id"] == sys.argv[1]:
        print(p.get("label") or "", p["pane_id"], sep="\t")
' "$1"
}

# pane_is_idle exits 0 if the pane shows its shell prompt, with no program.
pane_is_idle() {
  local info
  for _ in $(seq 1 20); do
    info="$(HERDR_SESSION="$SESSION" herdr pane process-info --pane "$1" 2>/dev/null)" || info=""
    case "$info" in
      *shell_pid*)
        python3 -I -c '
import json, sys
p = json.load(sys.stdin)["result"]["process_info"]
sys.exit(0 if p.get("shell_pid") and p.get("foreground_process_group_id") == p.get("shell_pid") else 1)
' <<<"$info"
        return
        ;;
    esac
    sleep 0.25
  done
  return 1
}

state_file() { printf '%s/%s.tsv' "$STATE_DIR" "$SESSION"; }

# remember_template LABEL TEMPLATE PANES writes one state line for a workspace.
# PANES is "id=name id=name". Herdr keeps the pane IDs after a restart, so
# hopen finds each template pane by its ID, even if a plugin renamed it.
remember_template() {
  local file
  file="$(state_file)"
  mkdir -p "$STATE_DIR"
  touch "$file"
  awk -F '\t' -v l="$1" '$1 != l' "$file" >"${file}.tmp"
  printf '%s\t%s\t%s\n' "$1" "$2" "${3:-}" >>"${file}.tmp"
  mv "${file}.tmp" "$file"
}

# restart_programs starts each template program again in a pane that shows only
# its shell. Herdr restores the panes after a stop, but not their programs.
restart_programs() {
  local file label template id panes pane from direction size command pane_id restarted=0
  file="$(state_file)"
  [ -f "$file" ] || return 0
  local all
  all="$(workspaces)"
  while IFS=$'\t' read -r label template saved; do
    template_exists "$template" && [ "$template" != plain ] || continue
    # A tab of a workspace has the state label "workspace/tab".
    id="$(awk -F '\t' -v l="${label%%/*}" '$1 == l {print $2}' <<<"$all")"
    [ -n "$id" ] || continue
    panes="$(panes_of "$id")"
    while read -r pane from direction size command; do
      # The saved ID comes first. The name is for state from older versions.
      pane_id="$(tr ' ' '\n' <<<"${saved:-}" | awk -F '=' -v n="$pane" '$2 == n {print $1; exit}')"
      if [ -z "$pane_id" ] || ! cut -f2 <<<"$panes" | grep -Fxq -- "$pane_id"; then
        pane_id="$(awk -F '\t' -v l="$pane" '$1 == l {print $2; exit}' <<<"$panes")"
      fi
      [ -n "$pane_id" ] || continue
      GUARD_PAIRS="${GUARD_PAIRS}${pane_id}"$'\t'"${pane}"$'\n'
      [ -n "$command" ] && [ "$command" != "-" ] || continue
      if pane_is_idle "$pane_id"; then
        HERDR_SESSION="$SESSION" herdr pane run "$pane_id" "$command" >/dev/null
        restarted=$((restarted + 1))
      fi
    done < <(template_lines "$template")
  done <"$file"
  [ "$restarted" -eq 0 ] || printf '  [info] Session %s: %s programs started again.\n' "$SESSION" "$restarted"
}

# ---------- trust

# list_actions ITEMS prints each command and environment value of a list.
list_actions() {
  awk -F '\036' '
    ($1 == "R" || $1 == "P") && $5 != "-" { print "    " $2 ": run " $5 }
    ($1 == "R" || $1 == "P") && $6 != "-" { gsub("\037", ", ", $6); print "    " $2 ": set " $6 }
    $1 == "T" && $5 != "-" { print "    " $2 ", tab " $3 ": run " $5 }
    $1 == "F" { print "    " $2 ": load " $3 " (" $4 ")" }
    $1 == "K" { print "    " $2 ", task " $3 ": run " $4 }
  ' <<<"$1"
}

# file_hash FILE [EXTRA] prints the checksum of FILE. EXTRA is the values that
# the list loads from env files, so that a change to them asks again. EXTRA
# goes on stdin, because another user can read the arguments of a process.
file_hash() {
  printf '%s' "${2:-}" | python3 -I -c '
import hashlib, sys
digest = hashlib.sha256(open(sys.argv[1], "rb").read())
extra = sys.stdin.buffer.read()
if extra:
    digest.update(b"\0" + extra)
print(digest.hexdigest())
' "$1"
}
trust_file() { printf '%s/trusted.tsv' "$STATE_DIR"; }

# list_trusted FILE ACTIONS [EXTRA] exits 0 if hopen can use the commands and values of
# FILE: the person approved this version of the file before, approves it now,
# or gave --trust. A changed file needs a new approval.
list_trusted() {
  local file="$1" actions="$2" hash answer
  hash="$(file_hash "$file" "${3:-}")" || return 1
  [[ "$hash" =~ ^[0-9a-f]{64}$ ]] || return 1
  awk -F '\t' -v f="$file" -v h="$hash" '$1 == f && $2 == h { found = 1 } END { exit !found }' "$(trust_file)" 2>/dev/null && return 0
  if [ "$TRUST_FLAG" -ne 1 ]; then
    [ -t 0 ] || return 1
    printf '  [info] %s runs these commands and sets these values:\n%s\n' "$(short_path "$file")" "$actions"
    printf '  Use them? Answer yes only for a list that you trust. [y/N] '
    IFS= read -r answer || answer=""
    case "$answer" in y | Y | yes | Yes) ;; *) return 1 ;; esac
  fi
  mkdir -p "$STATE_DIR"
  { awk -F '\t' -v f="$file" '$1 != f' "$(trust_file)" 2>/dev/null || true; printf '%s\t%s\n' "$file" "$hash"; } >"$(trust_file).new"
  mv "$(trust_file).new" "$(trust_file)"
}

# open_template TEMPLATE PANE STATE_LABEL splits PANE with TEMPLATE, starts its
# programs, and remembers the panes under STATE_LABEL.
open_template() {
  local template="$1" root="$2" state_label="$3" before
  [ "$template" != plain ] || return 0
  before="$GUARD_PAIRS"
  HERDR_SESSION="$SESSION" apply_template "$template" "$root"
  remember_template "$state_label" "$template" "$(printf '%s' "${GUARD_PAIRS#"$before"}" | tr '\t' '=' | tr '\n' ' ' | sed 's/ $//')"
}

# prepare_session starts SESSION and adds each folder that has no workspace.
# A new workspace gets its template, its on-open command, and its extra tabs.
prepare_session() {
  local items existing added=0 kind label folder template extra envs output root workspace_id item
  local current="" current_folder="" current_id="" file_env="" key
  STARTED=0
  session_answers || start_session
  [ "$STARTED" -eq 0 ] || restart_programs
  if [ -n "$FOLDER" ]; then
    # A folder with no list: one workspace, with no commands or values.
    items="$(printf 'R\036%s\036%s\036%s\036-\036-' "$SESSION" "$FOLDER" "${TEMPLATE_FLAG:-plain}")"
  else
    items="$(read_list "$LIST_FILE" items)" || die "Could not read ${LIST_FILE}."
  fi
  local actions trusted=1
  actions="$(list_actions "$items")"
  if [ -n "$actions" ] && ! list_trusted "$LIST_FILE" "$actions" "$(grep $'^F\x1e' <<<"$items" || true)"; then
    trusted=0
    warn "hopen did not use the commands and values of $(short_path "$LIST_FILE"). Run hopen in a terminal to approve them, or add --trust."
  fi
  existing="$(workspaces | cut -f1)"
  while IFS=$'\x1e' read -r kind label folder template extra envs; do
    [ "$extra" != "-" ] && [ "$trusted" -eq 1 ] || extra=""
    [ "$envs" != "-" ] && [ "$trusted" -eq 1 ] || envs=""
    case "$kind" in
      W) warn "$label"; continue ;;
      F)
        # The values of an env file, for the R or P line that comes next.
        # "extra" holds them here, and it is empty with no approval.
        file_env="$extra"
        continue
        ;;
      T)
        # A tab line: label, tab name (in "folder"), template, command.
        [ "$label" = "$current" ] && [ -n "$current_id" ] || continue
        if ! template_exists "$template"; then
          warn "${label}/${folder}: no template named ${template}. The tab opens with one pane."
          template="plain"
        fi
        output="$(HERDR_SESSION="$SESSION" herdr tab create --workspace "$current_id" --cwd "$current_folder" --label "$folder" --no-focus ${ENV_ARGS[@]+"${ENV_ARGS[@]}"})"
        root="$(json_get "d['result']['root_pane']['pane_id']" <<<"$output")"
        GUARD_TABS="${GUARD_TABS}${root}"$'\t'"${folder}"$'\n'
        open_template "$template" "$root" "${label}/${folder}"
        [ -z "$extra" ] || HERDR_SESSION="$SESSION" herdr pane run "$root" "$extra" >/dev/null
        continue
        ;;
      R) label="$SESSION" ;;
      P) ;;
      *) continue ;;
    esac
    current="$label"
    current_folder="$folder"
    current_id=""
    ENV_ARGS=()
    if [ -n "$envs" ]; then
      while IFS= read -r -d $'\x1f' item; do
        [ -z "$item" ] || ENV_ARGS+=(--env "$item")
      done <<<"${envs}"$'\x1f'
    fi
    # A value from the env file is used only if env does not set the name.
    if [ -n "$file_env" ]; then
      while IFS= read -r -d $'\x1f' item; do
        key="${item%%=*}"
        [ -n "$item" ] || continue
        case $'\x1f'"${envs}"$'\x1f' in *$'\x1f'"${key}="*) continue ;; esac
        ENV_ARGS+=(--env "$item")
      done <<<"${file_env}"$'\x1f'
    fi
    file_env=""
    if grep -Fxq -- "$label" <<<"$existing"; then
      continue
    fi
    if [ ! -d "$folder" ]; then
      warn "Skipped ${label}: the folder ${folder} does not exist."
      continue
    fi
    if ! template_exists "$template"; then
      warn "${label}: no template named ${template}. It opens with one pane."
      template="plain"
    fi
    output="$(HERDR_SESSION="$SESSION" herdr workspace create --cwd "$folder" --label "$label" --no-focus ${ENV_ARGS[@]+"${ENV_ARGS[@]}"})"
    root="$(json_get "d['result']['root_pane']['pane_id']" <<<"$output")"
    workspace_id="$(json_get "d['result']['workspace']['workspace_id']" <<<"$output")"
    current_id="$workspace_id"
    # The on-open command runs first. The shell then starts the template program.
    [ -z "$extra" ] || HERDR_SESSION="$SESSION" herdr pane run "$root" "$extra" >/dev/null
    open_template "$template" "$root" "$label"
    added=$((added + 1))
  done <<<"$items"
  printf '  [info] Session %s: %s workspaces added.\n' "$SESSION" "$added"
  HERDR_SESSION="$SESSION" guard_names
}

attach_session() {
  if [ "${HERDR_ENV:-}" = "1" ]; then
    die "You are in a Herdr pane. Press ctrl+b, then q, and run this command again."
  fi
  exec herdr session attach "$SESSION"
}

show_lists() {
  local lists name state count
  lists="$(find_lists)"
  [ -n "$lists" ] || die "No project lists. Create ~/work.code-workspace or ~/work/herdspace.toml."
  printf '%-22s %-9s %-11s %s\n' SESSION STATE WORKSPACES LIST
  while IFS=$'\t' read -r name LIST_FILE; do
    SESSION="$name"
    if session_answers; then
      state="running"
      count="$(workspaces | wc -l | tr -d ' ')"
    else
      state="stopped"
      count="-"
    fi
    printf '%-22s %-9s %-11s %s\n' "$name" "$state" "$count" "$(short_path "$LIST_FILE")"
  done <<<"$lists"
}

open_all() {
  local lists wanted="$SESSION" name
  lists="$(find_lists)"
  [ -n "$lists" ] || die "No project lists. Create ~/work.code-workspace or ~/work/herdspace.toml."
  if [ -n "$wanted" ] && ! grep -q "^${wanted}"$'\t' <<<"$lists"; then
    die "No project list for ${wanted}."
  fi
  while IFS=$'\t' read -r name LIST_FILE; do
    SESSION="$name"
    prepare_session
  done <<<"$lists"
  if [ -n "$wanted" ]; then
    SESSION="$wanted"
    attach_session
  fi
  printf '  [info] Run hopen with a session name to attach, for example: hopen %s\n' "$(printf '%s' "$lists" | head -n 1 | cut -f1)"
}

# apply_here splits the current tab of a Herdr pane with a template.
apply_here() {
  [ "${HERDR_ENV:-}" = "1" ] && [ -n "${HERDR_PANE_ID:-}" ] || die "Run --apply inside a Herdr pane."
  template_exists "$APPLY_NAME" || die "No template named ${APPLY_NAME}. Run hopen --templates."
  [ "$APPLY_NAME" != plain ] || return 0
  local tab count
  tab="$(herdr pane list | python3 -I -c '
import json, sys
print([p["tab_id"] for p in json.load(sys.stdin)["result"]["panes"] if p["pane_id"] == sys.argv[1]][0])
' "$HERDR_PANE_ID")"
  count="$(herdr pane list | python3 -I -c '
import json, sys
print(len([p for p in json.load(sys.stdin)["result"]["panes"] if p["tab_id"] == sys.argv[1]]))
' "$tab")"
  [ "$count" = 1 ] || die "The current tab has ${count} panes. Open a new tab, and run --apply there."
  apply_template "$APPLY_NAME" "$HERDR_PANE_ID"
  guard_names
}

# convert_list writes ~/SESSION/herdspace.toml from the VS Code list of SESSION.
# It never replaces a file.
convert_list() {
  local source target items
  target="${HOME}/${SESSION}/herdspace.toml"
  [ ! -e "$target" ] || die "${target} exists. Move it, and run --convert again."
  source="$(find_list_for "$SESSION")"
  case "$source" in
    *.code-workspace) ;;
    *) die "No VS Code list for ${SESSION}." ;;
  esac
  mkdir -p "${HOME}/${SESSION}"
  items="$(mktemp)"
  read_list "$source" items >"$items" || { rm -f "$items"; die "Could not read ${source}."; }
  python3 -I - "$source" "$target" "$HOME" "$items" <<'PY'
import os, sys

source, target, home, items = sys.argv[1:5]
target_dir = os.path.dirname(target)

def quote(text):
    return '"' + text.replace("\\", "\\\\").replace('"', '\\"') + '"'

def where(path):
    relative = os.path.relpath(path, target_dir)
    if not relative.startswith(".."):
        return relative
    if path.startswith(home + os.sep):
        return "~/" + os.path.relpath(path, home)
    return path

def env_table(pairs):
    return "{ " + ", ".join(key + " = " + quote(value) for key, value in pairs) + " }"

def task_table(pairs):
    return "{ " + ", ".join(quote(name) + " = " + quote(command) for name, command in pairs) + " }"

def near(path, folder):
    # A path relative to folder if it is inside folder, else ~/... or absolute.
    relative = os.path.relpath(path, folder)
    if not relative.startswith(".."):
        return relative
    if path.startswith(home + os.sep):
        return "~/" + os.path.relpath(path, home)
    return path

parent = None
projects = []
pending_file = ""
# splitlines() also ends a line at the byte 0x1e, so split at new lines only.
for raw in open(items, encoding="utf-8").read().split("\n"):
    if not raw:
        continue
    kind, *fields = raw.split("\x1e")
    fields = ["" if value == "-" else value for value in fields] + [""] * 5
    if kind == "F":
        # Keep the path of the env file, not its values.
        pending_file = fields[1]
    elif kind in ("R", "P"):
        entry = {"label": fields[0], "path": fields[1], "template": fields[2], "on_open": fields[3], "tabs": [],
                 "env": [item.split("=", 1) for item in fields[4].split("\x1f") if "=" in item],
                 "env_file": pending_file}
        pending_file = ""
        if kind == "R":
            parent = entry
        else:
            projects.append(entry)
    elif kind == "K":
        owner = projects[-1] if projects else parent
        if owner is not None and owner["label"] == fields[0]:
            owner.setdefault("tasks", []).append((fields[1], fields[2]))
    elif kind == "T" and projects and projects[-1]["label"] == fields[0]:
        projects[-1]["tabs"].append({"name": fields[1], "template": fields[2], "run": fields[3]})

lines = ["# Written by hopen --convert from " + source.replace(home, "~", 1) + ".", ""]
if parent is None:
    lines += ["parent_workspace = false", ""]
else:
    if parent["template"] != "plain":
        lines.append("parent_template = " + quote(parent["template"]))
    if parent["on_open"]:
        lines.append("on_open = " + quote(parent["on_open"]))
    if parent["env"]:
        lines.append("env = " + env_table(parent["env"]))
    if parent["env_file"]:
        lines.append("env_file = " + quote(near(parent["env_file"], target_dir)))
    if parent.get("tasks"):
        lines.append("tasks = " + task_table(parent["tasks"]))
    if len(lines) > 2:
        lines.append("")
for project in projects:
    lines += ["[[project]]", "name = " + quote(project["label"]), "path = " + quote(where(project["path"]))]
    if project["template"] != "plain":
        lines.append("template = " + quote(project["template"]))
    if project["on_open"]:
        lines.append("on_open = " + quote(project["on_open"]))
    if project["env"]:
        lines.append("env = " + env_table(project["env"]))
    if project["env_file"]:
        lines.append("env_file = " + quote(near(project["env_file"], project["path"])))
    if project.get("tasks"):
        lines.append("tasks = " + task_table(project["tasks"]))
    if project["tabs"]:
        tabs = []
        for tab in project["tabs"]:
            text = "{ name = " + quote(tab["name"]) + ", template = " + quote(tab["template"])
            if tab["run"]:
                text += ", run = " + quote(tab["run"])
            tabs.append(text + " }")
        lines.append("tabs = [" + ", ".join(tabs) + "]")
    lines.append("")
with open(target, "w", encoding="utf-8") as handle:
    handle.write("\n".join(lines).rstrip() + "\n")
PY
  rm -f "$items"
  printf '  [info] Wrote %s. hopen now uses it in place of %s.\n' "$(short_path "$target")" "$(short_path "$source")"
}

# project_for_dir DIR prints "list file<TAB>label" for the project that holds
# DIR. The deepest project folder wins, so a project wins over the parent
# workspace of its list.
project_for_dir() {
  local dir="$1" name file
  find_lists 2>/dev/null | while IFS=$'\t' read -r name file; do
    read_list "$file" items 2>/dev/null | awk -F '\036' -v f="$file" '($1 == "R" || $1 == "P") { print $3 "\t" f "\t" $2 }'
  done | awk -F '\t' -v d="$dir" '
    (d == $1 || index(d, $1 "/") == 1) && length($1) > best { best = length($1); found = $2 "\t" $3 }
    END { if (found == "") exit 1; print found }'
}

# env_for ITEMS LABEL sets ENV_ARGS to the environment values of one project:
# its env values, and the values of its env file that env does not set.
env_for() {
  local items="$1" label="$2" envs file_env item key
  envs="$(awk -F '\036' -v l="$label" '($1 == "R" || $1 == "P") && $2 == l && $6 != "-" { print $6; exit }' <<<"$items")"
  file_env="$(awk -F '\036' -v l="$label" '$1 == "F" && $2 == l { print $5; exit }' <<<"$items")"
  ENV_ARGS=()
  if [ -n "$envs" ]; then
    while IFS= read -r -d $'\x1f' item; do
      [ -z "$item" ] || ENV_ARGS+=(--env "$item")
    done <<<"${envs}"$'\x1f'
  fi
  if [ -n "$file_env" ]; then
    while IFS= read -r -d $'\x1f' item; do
      key="${item%%=*}"
      [ -n "$item" ] || continue
      case $'\x1f'"${envs}"$'\x1f' in *$'\x1f'"${key}="*) continue ;; esac
      ENV_ARGS+=(--env "$item")
    done <<<"${file_env}"$'\x1f'
  fi
}

# run_task runs a task of the project of the current folder. In Herdr, it runs
# in a new pane below the current pane. A popup of Herdr has no pane of its
# own, so there it splits the active pane. Outside Herdr, it runs here.
run_task() {
  local dir="${HERDR_ACTIVE_PANE_CWD:-$PWD}" match file label items tasks command actions output pane item
  match="$(project_for_dir "$dir")" || die "No project of a list holds the folder $(short_path "$dir")."
  file="${match%%$'\t'*}"
  label="${match#*$'\t'}"
  items="$(read_list "$file" items)" || die "Could not read ${file}."
  tasks="$(awk -F '\036' -v l="$label" '$1 == "K" && $2 == l { print $3 "\t" $4 }' <<<"$items")"
  [ -n "$tasks" ] || die "The project ${label} has no tasks. Add tasks to $(short_path "$file"). See docs/hopen.md."
  if [ -z "$TASK_NAME" ]; then
    if [ -t 0 ] && [ -t 1 ]; then
      TASK_NAME="$(while IFS=$'\t' read -r item command; do printf '%s\t%-14s %s\n' "$item" "$item" "$command"; done <<<"$tasks" | choose "Run which task")" || exit 1
      [ -n "$TASK_NAME" ] || exit 0
    else
      printf '%s\n' "$tasks"
      return 0
    fi
  fi
  command="$(awk -F '\t' -v n="$TASK_NAME" '$1 == n { print $2; exit }' <<<"$tasks")"
  [ -n "$command" ] || die "The project ${label} has no task ${TASK_NAME}. Its tasks: $(cut -f1 <<<"$tasks" | tr '\n' ' ')"
  actions="$(list_actions "$items")"
  list_trusted "$file" "$actions" "$(grep $'^F\x1e' <<<"$items" || true)" ||
    die "hopen runs a task only from an approved list. Run hopen --task in a terminal to approve $(short_path "$file"), or add --trust."
  env_for "$items" "$label"
  pane="${HERDR_PANE_ID:-${HERDR_ACTIVE_PANE_ID:-}}"
  if [ -n "$pane" ]; then
    output="$(herdr pane split "$pane" --direction down --ratio 0.65 --focus ${ENV_ARGS[@]+"${ENV_ARGS[@]}"})" || die "Could not split the pane."
    pane="$(json_get "d['result']['pane']['pane_id']" <<<"$output")"
    herdr pane rename "$pane" "$TASK_NAME" >/dev/null
    herdr pane run "$pane" "cd $(printf '%q' "$dir") && ${command}" >/dev/null
    printf '  [info] Task %s runs in a new pane: %s\n' "$TASK_NAME" "$command"
  else
    printf '  [info] Task %s: %s\n' "$TASK_NAME" "$command"
    for item in ${ENV_ARGS[@]+"${ENV_ARGS[@]}"}; do
      [ "$item" = --env ] || export "${item?}"
    done
    cd "$dir" && exec "${SHELL:-/bin/sh}" -c "$command"
  fi
}

case "$ACTION" in
  completion) completion_script "$SHELL_NAME"; exit 0 ;;
  task) run_task; exit 0 ;;
  complete)
    # The completion scripts call this. It prints one name on each line.
    case "$COMPLETE_WHAT" in
      lists) find_lists 2>/dev/null | cut -f1 ;;
      templates) show_templates | tail -n +2 | cut -d ' ' -f1 ;;
      tasks)
        match="$(project_for_dir "$PWD")" || exit 0
        read_list "${match%%$'\t'*}" items 2>/dev/null | awk -F '\036' -v l="${match#*$'\t'}" '$1 == "K" && $2 == l { print $3 }'
        ;;
    esac
    exit 0
    ;;
  list) show_lists; exit 0 ;;
  convert) convert_list; exit 0 ;;
  templates) show_templates; exit 0 ;;
  apply) apply_here; exit 0 ;;
esac

if [ -n "$TEMPLATE_FLAG" ] && ! template_exists "$TEMPLATE_FLAG"; then
  die "No template named ${TEMPLATE_FLAG}. Run hopen --templates."
fi

if [ "$ACTION" = all ]; then
  [ -z "$SESSION" ] || valid_name "$SESSION" || die "A session name can use only letters, numbers, dots, dashes, and underscores."
  open_all
  exit 0
fi

# choose PROMPT shows a menu of the lines on stdin, one "key<TAB>text" line for
# each item, and prints the key that the person chose. It uses fzf if it is
# installed, else a numbered menu that takes a number or a key. It prints
# nothing if the person cancels, and it exits 1 for an unknown answer.
choose() {
  local prompt="$1" items answer="" name text i=0
  items="$(cat)"
  # fzf draws nothing with no TERM, or with TERM=dumb.
  if command -v fzf >/dev/null 2>&1 && [ -n "${TERM:-}" ] && [ "${TERM}" != dumb ]; then
    fzf --delimiter '\t' --with-nth 2.. --prompt "${prompt} > " --header 'Esc cancels.' --height 40% --reverse --no-multi <<<"$items" | cut -f1 || true
    return 0
  fi
  while IFS=$'\t' read -r name text; do
    i=$((i + 1))
    printf '  %2d) %s\n' "$i" "$text" >&2
  done <<<"$items"
  printf '  %s? Type a number or a name: ' "$prompt" >&2
  IFS= read -r answer || answer=""
  case "$answer" in
    "") return 0 ;;
    *[!0-9]*) name="$(awk -F '\t' -v n="$answer" '$1 == n {print $1; exit}' <<<"$items")" ;;
    *) name="$(awk -F '\t' -v n="$answer" 'NR == n {print $1; exit}' <<<"$items")" ;;
  esac
  [ -n "$name" ] || { printf '  [err]  No item %s.\n' "$answer" >&2; return 1; }
  printf '%s\n' "$name"
}

# pick_list lets the person choose a list when hopen gets no name in a
# terminal.
pick_list() {
  local lists name file
  lists="$(find_lists)"
  [ -n "$lists" ] || die "No project lists. Create ~/work/herdspace.toml, or run hopen . in a folder."
  SESSION="$(while IFS=$'\t' read -r name file; do printf '%s\t%-22s %s\n' "$name" "$name" "$(short_path "$file")"; done <<<"$lists" | choose "Open which list")" || exit 1
  [ -n "$SESSION" ] || exit 0
}

if [ -z "$SESSION" ] && [ -t 0 ] && [ -t 1 ]; then
  if [ "${HERDR_ENV:-}" = "1" ] && [ "$ATTACH" -eq 1 ]; then
    die "You are in a Herdr pane. Press ctrl+b, then q, and run this command again."
  fi
  pick_list
fi

[ -n "$SESSION" ] || { usage >&2; exit 2; }

# open_folder handles "hopen <folder>". It uses the list in the folder, if the
# folder has one. Else the session and its one workspace get the folder name.
open_folder() {
  local path name list owner
  path="$(cd "$SESSION" 2>/dev/null && pwd -P)" || die "No folder ${SESSION}."
  [[ "$path" != *[[:cntrl:]]* ]] || die "The folder name has a control character."
  name="$(basename "$path")"
  for list in "${path}/herdspace.toml" "${path}/${name}.code-workspace"; do
    if [ -f "$list" ]; then
      LIST_FILE="$list"
      SESSION="$(read_list "$list" session)" || die "Could not read ${list}."
      # The same rule as find_lists: a list in a folder cannot take the
      # session of another list. Its commands and values still need approval.
      owner="$(find_list_for "$SESSION" 2>/dev/null)"
      if [ -n "$owner" ] && [ "$owner" != "$list" ]; then
        die "$(short_path "$list") uses the session ${SESSION}, which $(short_path "$owner") has. Give the list another session name."
      fi
      return 0
    fi
  done
  FOLDER="$path"
  # A session name uses letters, numbers, dots, dashes, and underscores only.
  SESSION="$(printf '%s' "$name" | tr -c 'A-Za-z0-9._-' '-')"
  [ "$SESSION" != "." ] && [ "$SESSION" != ".." ] || SESSION="-"
  list="$(find_list_for "$SESSION" 2>/dev/null)"
  [ -z "$list" ] || warn "The list $(short_path "$list") uses the session ${SESSION}. hopen adds the folder to that session."
}

case "$SESSION" in
  . | .. | */*)
    [ -z "$LIST_FILE" ] || die "Use --file with a session name, not with a folder."
    open_folder
    ;;
esac

valid_name "$SESSION" || die "A session name can use only letters, numbers, dots, dashes, and underscores."

if [ "${HERDR_ENV:-}" = "1" ] && [ "$ATTACH" -eq 1 ]; then
  die "You are in a Herdr pane. Press ctrl+b, then q, and run this command again."
fi

if [ -z "$LIST_FILE" ] && [ -z "$FOLDER" ]; then
  LIST_FILE="$(find_list_for "$SESSION")"
fi

if [ -z "$FOLDER" ] && { [ -z "$LIST_FILE" ] || [ ! -f "$LIST_FILE" ]; }; then
  die "No list of projects for ${SESSION}. Create ~/${SESSION}.code-workspace or ~/${SESSION}/herdspace.toml."
fi

prepare_session

if [ "$ATTACH" -eq 1 ]; then
  attach_session
fi
