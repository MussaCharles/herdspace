#!/usr/bin/env bash
# hopen opens all the projects of a list in one named Herdr session, with one
# Herdr workspace for each folder, and then attaches to it. A list is a VS Code
# workspace file or a herdspace.toml file. docs/hopen.md explains both.
#
# Run it again at any time. It starts a stopped session, adds only the folders
# that have no workspace, and closes nothing. The first workspace has the name
# of the session and opens the folder that holds the list file.
#
# A template splits a new workspace into named panes and starts a program in
# each. After a stopped session starts again, hopen starts those programs again.
#
# Usage: hopen <session> [--template NAME] [--file PATH] [--no-attach] [--trust]
#        hopen                   In a terminal, choose a list from a menu.
#        hopen <folder>          Open a folder, for example "hopen .". A list in
#                                the folder wins. Else one workspace, no list.
#        hopen --all [session] [--template NAME]
#        hopen --list            Show every list and its state.
#        hopen --templates       Show every template.
#        hopen --apply NAME      Split the current tab with a template.
#        hopen --convert NAME    Write ~/NAME/herdspace.toml from the VS Code list NAME.
#        hopen --completion zsh|bash   Print a shell completion script.
#        hopen --task [NAME]     Run a task of the project of the current folder.
#        hopen --find            Choose a file with fzf, and open it in the editor.
#        hopen --quick-open      Choose a file of the project, and open it in the editor
#                                of the tab, with the focus on it (Cmd+P in Herdr).
#        hopen --grep TEXT       Search the files, and open a result at its line.
#        --with-ignored FOLDER   With --find, --quick-open, or --grep: search only
#                                FOLDER, with the files that .gitignore names. Repeat
#                                it for more folders.
#        hopen --ports           Show the TCP ports that your programs listen on.
#        hopen --palette         Choose an action from a menu, like the command
#                                palette of VS Code. Cmd+Shift+P opens it in Herdr.
#
# A list can run commands (on-open and tab commands) and set environment
# values. hopen asks before it uses them the first time, and again after the
# list changes. With no terminal, it uses them only with --trust.
set -euo pipefail

# The release script writes the release tag here.
HOPEN_VERSION="dev"

# hopen is Python, in lib/hopen next to the bin folder of this file. This file
# finds that folder, picks Python 3.11 or later, and starts it. The setup
# installs the modules to ~/.local/lib/hopen, next to ~/.local/bin/hopen.

# hopen_lib prints the folder of the modules of hopen, also when hopen is a
# symbolic link.
hopen_lib() {
  local self="${BASH_SOURCE[0]}" dir
  while [ -L "$self" ]; do
    dir="$(cd "$(dirname "$self")" && pwd -P)"
    self="$(readlink "$self")"
    case "$self" in /*) ;; *) self="${dir}/${self}" ;; esac
  done
  dir="$(cd "$(dirname "$self")" && pwd -P)"
  printf '%s/../lib/hopen' "$dir"
}

# hopen_python prints Python 3.11 or later, which has tomllib for
# herdspace.toml. Some systems have an older python3 and a newer python3.N
# beside it, for example Ubuntu 22.04. With no Python 3.11, it prints python3,
# which still reads a VS Code workspace file.
hopen_python() {
  local py
  for py in python3 python3.14 python3.13 python3.12 python3.11; do
    command -v "$py" >/dev/null 2>&1 || continue
    "$py" -I -c 'import sys; sys.exit(sys.version_info < (3, 11))' 2>/dev/null && { printf '%s' "$py"; return 0; }
  done
  printf 'python3'
}

HOPEN_LIB="$(hopen_lib)"
[ -f "${HOPEN_LIB}/__main__.py" ] || { printf '  [err]  hopen cannot find its modules in %s. Run: herdspace update\n' "$HOPEN_LIB" >&2; exit 1; }
HOPEN_PY="$(hopen_python)"
command -v "$HOPEN_PY" >/dev/null 2>&1 || { printf '  [err]  hopen needs Python 3.11 or later. The server setup installs it.\n' >&2; exit 1; }
# -I keeps out the environment and the current folder, and -B writes no
# __pycache__ folder next to the installed files.
exec "$HOPEN_PY" -I -B "${HOPEN_LIB}/__main__.py" hopen "$HOPEN_VERSION" "$0" "$@"
