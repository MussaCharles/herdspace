#!/usr/bin/env bash
# herdspace shows the installed version, says when a new release exists, and
# updates the setup with the role and the options of the last setup.
#
# Usage: herdspace update [setup options]  Update to the latest release.
#        herdspace update --force          Run the setup again on the latest release.
#        herdspace update --version TAG    Install the release TAG, also an older one.
#        herdspace --version               The installed and the latest version.
#        herdspace version                 The same as --version.
#        herdspace keys [normal|herdr]     Show or change the Ghostty keys (client).
#        herdspace uninstall --check       List what an uninstall changes. Change nothing.
#        herdspace uninstall [--yes]       Remove what the setup wrote. Ask once first.
#        herdspace help                    This help.
#
# The herdspace shell runs "herdspace notice" when it starts: at most once a
# day, it prints one line when a new release exists. It asks GitHub in the
# background, so the shell does not wait. HERDSPACE_UPDATE_CHECK=0 turns it off.
set -uo pipefail
REPO="${HS_REPO:-MussaCharles/herdspace}"
STATE="${HOME}/.local/share/herdspace"
CACHE="${XDG_CACHE_HOME:-$HOME/.cache}/herdspace"

usage() { sed -n '2,/^[^#]/{/^#/p;}' "$0" | sed 's/^# \{0,1\}//'; }
die() { printf '  [err]  %s\n' "$*" >&2; exit 1; }

installed() { cat "${STATE}/version" 2>/dev/null || echo unknown; }

# latest_now asks GitHub for the tag of the latest release. The latest release
# is never a pre-release. It sends no data about this machine.
latest_now() {
  curl -fsSI --connect-timeout 3 --max-time 6 "https://github.com/${REPO}/releases/latest" 2>/dev/null |
    tr -d '\r' | awk 'tolower($1) == "location:" {print $2}' | tail -n 1 | sed -n 's|.*/releases/tag/\([0-9][^/]*\)$|\1|p'
}

# newer A B succeeds if version A is newer than version B.
newer() {
  case "$1$2" in *[!0-9.]*) return 1 ;; esac
  [ "$1" != "$2" ] && [ "$(printf '%s\n%s\n' "$1" "$2" | sort -t . -k 1,1n -k 2,2n -k 3,3n | tail -n 1)" = "$1" ]
}

sha_of() { if command -v sha256sum >/dev/null 2>&1; then sha256sum "$1" | cut -d ' ' -f 1; else shasum -a 256 "$1" | cut -d ' ' -f 1; fi; }

# fresh FILE MINUTES succeeds if FILE changed in the last MINUTES.
fresh() { [ -n "$(find "$1" -mmin "-$2" 2>/dev/null)" ]; }

cmd_version() {
  local have latest
  have="$(installed)"
  printf 'herdspace %s\n' "$have"
  latest="$(latest_now)"
  if [ -z "$latest" ]; then
    printf 'The latest release: unknown. GitHub did not answer.\n'
  elif newer "$latest" "$have"; then
    printf 'The latest release: %s. Run: herdspace update\n' "$latest"
  else
    printf 'The latest release: %s. This is the latest version.\n' "$latest"
  fi
}

cmd_refresh() {
  local latest
  mkdir -p "$CACHE"
  latest="$(latest_now)"
  [ -n "$latest" ] && printf '%s\n' "$latest" >"${CACHE}/latest"
  touch "${CACHE}/latest-checked"
}

cmd_notice() {
  local latest have
  [ "${HERDSPACE_UPDATE_CHECK:-1}" != 0 ] || return 0
  mkdir -p "$CACHE" 2>/dev/null || return 0
  if ! fresh "${CACHE}/latest-checked" 1440; then
    touch "${CACHE}/latest-checked"
    nohup "$0" refresh >/dev/null 2>&1 </dev/null &
  fi
  latest="$(cat "${CACHE}/latest" 2>/dev/null)"
  have="$(installed)"
  [ -n "$latest" ] && newer "$latest" "$have" || return 0
  fresh "${CACHE}/notice-shown" 1440 && return 0
  touch "${CACHE}/notice-shown"
  printf '  herdspace %s is available (you have %s). Run: herdspace update\n' "$latest" "$have"
  printf '  What changed: https://github.com/%s/releases/tag/%s\n' "$REPO" "$latest"
}

# keep_known_args BOOTSTRAP ARG... prints the saved options that the
# bootstrap.sh of an older release lists in its help. An older release stops on
# an option of a newer release, so the setup leaves that option out, and this
# function names it on stderr.
keep_known_args() {
  local file="$1" a skip=0 take=0
  shift
  for a in "$@"; do
    if [ "$skip" -eq 1 ]; then skip=0; continue; fi
    if [ "$take" -eq 1 ]; then take=0; printf '%s\n' "$a"; continue; fi
    case "$a" in
      --*)
        if grep -qF -- "$a" "$file"; then
          printf '%s\n' "$a"
          case "$a" in --server | --os) take=1 ;; esac
        else
          printf '  This release does not know the option %s, so the setup leaves it out.\n' "$a" >&2
          case "$a" in --server | --os) skip=1 ;; esac
        fi
        ;;
      *) printf '%s\n' "$a" ;;
    esac
  done
}

cmd_update() {
  local latest have role="" os="" line work args=() want force=0 a extra=() tag="" kept=()
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --force) force=1 ;;
      --version)
        [ "$#" -ge 2 ] || die "--version needs a release tag, for example: herdspace update --version 0.9.0"
        tag="$2"
        shift
        ;;
      --version=*) tag="${1#--version=}" ;;
      *) extra+=("$1") ;;
    esac
    shift
  done
  case "$tag" in
    "") ;;
    v[0-9]*) die "A release tag has no v in front. Use: herdspace update --version ${tag#v}" ;;
    *[!0-9A-Za-z.-]* | *..* | -* | .*) die "'${tag}' is not a release tag. A tag is a version, for example 0.9.0." ;;
    [0-9]*.[0-9]*.[0-9]*) ;;
    *) die "'${tag}' is not a release tag. A tag is a version, for example 0.9.0." ;;
  esac
  set -- ${extra[@]+"${extra[@]}"}
  [ -f "${STATE}/last-setup" ] || die "No setup is saved on this machine. Run the setup once, as the Quick start shows: https://github.com/${REPO}#quick-start"
  while IFS= read -r line; do
    case "$line" in
      role=*) role="${line#role=}" ;;
      os=*) os="${line#os=}" ;;
      arg=*) args+=("${line#arg=}") ;;
    esac
  done <"${STATE}/last-setup"
  case "$role" in server | client | both) ;; *) die "The saved setup has no role. Run the setup once again." ;; esac
  [ -z "$os" ] || args=(--os "$os" ${args[@]+"${args[@]}"})
  have="$(installed)"
  if [ -n "$tag" ]; then
    latest="$tag"
    if [ "$tag" = "$have" ] && [ "$force" -eq 0 ]; then
      printf '  herdspace %s is installed already. Nothing to change.\n' "$have"
      printf '  To run the setup again anyway, run: herdspace update --version %s --force\n' "$have"
      return 0
    elif [ "$tag" = "$have" ]; then
      printf '  herdspace %s is installed already. The setup runs again, because of --force.\n' "$have"
    elif newer "$have" "$tag"; then
      printf '  Going back from herdspace %s to the older release %s.\n' "$have" "$tag"
    else
      printf '  Changing herdspace from %s to %s.\n' "$have" "$tag"
    fi
  else
    latest="$(latest_now)"
    [ -n "$latest" ] || die "GitHub did not answer, so the latest release is unknown. Try again later."
    if [ "$latest" = "$have" ] && [ "$force" -eq 0 ]; then
      printf '  herdspace %s is the latest release. Nothing to update.\n' "$have"
      printf '  To run the setup again anyway, run: herdspace update --force\n'
      return 0
    elif [ "$latest" = "$have" ]; then
      printf '  herdspace %s is the latest release. The setup runs again, because of --force.\n' "$have"
    else
      printf '  Updating herdspace from %s to %s.\n' "$have" "$latest"
      printf '  What changed: https://github.com/%s/releases/tag/%s\n' "$REPO" "$latest"
    fi
  fi
  work="$(mktemp -d)"
  # The EXIT trap runs after this function returns, when the local work is
  # gone, so it uses a global name.
  HS_UPDATE_WORK="$work"
  trap 'rm -rf "${HS_UPDATE_WORK:-}"' EXIT
  for f in bootstrap.sh SHA256SUMS; do
    curl -fsSL "https://github.com/${REPO}/releases/download/${latest}/${f}" -o "${work}/${f}" ||
      die "Could not download ${f} of ${latest}.${tag:+ Does this release exist? The list: https://github.com/${REPO}/releases}"
  done
  want="$(awk '$2 == "bootstrap.sh" || $2 == "*bootstrap.sh" {print $1}' "${work}/SHA256SUMS")"
  [ -n "$want" ] && [ "$(sha_of "${work}/bootstrap.sh")" = "$want" ] || die "The checksum of bootstrap.sh is wrong. Nothing was changed."
  if [ -n "$tag" ] && [ "${#args[@]}" -gt 0 ]; then
    while IFS= read -r a; do kept+=("$a"); done < <(keep_known_args "${work}/bootstrap.sh" "${args[@]}")
    args=(${kept[@]+"${kept[@]}"})
  fi
  printf '  The setup runs: bootstrap.sh %s %s\n' "$role" "${args[*]:-}${*:+ $*}"
  HS_VERSION="$latest" bash "${work}/bootstrap.sh" "$role" ${args[@]+"${args[@]}"} "$@"
  local rc=$?
  rm -rf "$work"
  rm -f "${CACHE}/latest" "${CACHE}/notice-shown"
  [ "$rc" -ne 0 ] || [ ! -x "${HOME}/.local/bin/herdr-update-check" ] || "${HOME}/.local/bin/herdr-update-check" --now
  return "$rc"
}

# cmd_keys [normal|herdr] shows or changes the Ghostty keys of a client. It
# runs the setup of the installed release again with the key option, so that
# the Ghostty file, the Linux keys, and Mission Control on a Mac all change.
cmd_keys() {
  local want="${1:-}" now role="" os="" line flag value args=() src
  [ -f "${STATE}/last-setup" ] || die "No setup is saved on this machine. Run the setup once, as the Quick start shows: https://github.com/${REPO}#quick-start"
  while IFS= read -r line; do
    case "$line" in
      role=*) role="${line#role=}" ;;
      os=*) os="${line#os=}" ;;
      arg=--keep-terminal-keys | arg=--use-herdspace-keys) ;;
      arg=*) args+=("${line#arg=}") ;;
    esac
  done <"${STATE}/last-setup"
  case "$role" in
    client | both) ;;
    *) die "herdspace keys changes the keys of Ghostty on a client machine. This machine has a ${role:-unknown} setup." ;;
  esac
  now="$(cat "${HOME}/.config/herdspace/keys" 2>/dev/null || echo herdspace)"
  case "$want" in
    "")
      if [ "$now" = "terminal" ]; then
        printf '  The keys: normal. Ghostty keeps its own keys, for example Cmd+T for a new tab.\n'
        printf '  To send these keys to Herdr, run: herdspace keys herdr\n'
      else
        printf '  The keys: herdr. Cmd+T, Cmd+W, and Cmd+K go to Herdr (Ctrl+Shift+T and others on Linux).\n'
        printf '  Outside Herdr, these keys do nothing. To give them back to Ghostty, run: herdspace keys normal\n'
      fi
      return 0
      ;;
    normal) flag="--keep-terminal-keys"; value="terminal" ;;
    herdr) flag="--use-herdspace-keys"; value="herdspace" ;;
    *) printf "herdspace: '%s' is not a key mode. Use 'normal' or 'herdr'.\n" "$want" >&2; exit 2 ;;
  esac
  if [ "$now" = "$value" ]; then
    printf '  The keys are %s already. Nothing to change.\n' "$want"
    return 0
  fi
  src="${XDG_DATA_HOME:-$HOME/.local/share}/herdspace/$(installed)/bootstrap.sh"
  [ -f "$src" ] || die "The files of herdspace $(installed) are missing. Run: herdspace update --force ${flag}"
  [ -z "$os" ] || args=(--os "$os" ${args[@]+"${args[@]}"})
  printf '  The setup runs again with %s.\n' "$flag"
  bash "$src" "$role" ${args[@]+"${args[@]}"} "$flag"
}

# ---------- uninstall
# herdspace uninstall removes what the setup wrote, and nothing else. The
# manifest, ~/.local/share/herdspace/manifest.tsv, holds the hash of each file
# that the setup wrote. A file with that hash has no change of yours, so it goes.
# A file with another hash is yours now, so it stays. The marked blocks go from
# the shell and Ghostty files, and your own lines stay.

# These lines are in a new ~/.zshrc and a new Ghostty file, outside the blocks.
# A file with only these lines and blanks holds nothing of yours.
TEMPLATE_LINES='# Your zsh configuration. herdspace changes only the marked block, and it
# never replaces this file.
# Put your own lines below. They load after herdspace, so they can change
# what it sets.
# Ghostty configuration. herdspace changes only its marked blocks, and it
# never replaces this file. Ghostty uses the last value of each setting, so
# a line of yours below the blocks wins.
# Put your own lines below.'
# The files with marked blocks, and the names of the blocks. The block "herdspace
# bash env" is not in the list: it holds your exports, so it always stays.
BLOCK_FILES=".zshrc .zprofile .config/ghostty/config.ghostty"
BLOCK_NAMES="herdspace|herdspace extras|herdspace keys|herdspace ssh|herdspace appearance"
# Folders that other programs share. The uninstall never removes them.
SHARED_DIRS=".config .local .local/bin .local/share .cache Library Library/LaunchAgents Library/Application_Support .config/systemd .config/systemd/user"
UN_CHECK=1
UN_KEPT=""
UN_GONE=""
UN_DIRS=""
UN_SELF_KEEP=0
UN_UNIT="${HOME}/.config/systemd/user/herdr.service"
UN_PLIST="${HOME}/Library/LaunchAgents/local.herdr.server.plist"

# un_home PATH prints PATH with ~ for the home folder.
un_home() { case "$1" in "$HOME"/*) printf '~%s' "${1#"$HOME"}" ;; *) printf '%s' "$1" ;; esac; }

# un_say VERB TEXT prints one line of the plan, or of the result. In a check,
# the verb is the plain form ("remove"), and in an uninstall it is the past ("removed").
un_say() {
  local verb="$1"
  [ "$UN_CHECK" -eq 1 ] || case "$verb" in
    remove) verb="removed" ;;
    edit) verb="edited" ;;
    restore) verb="restored" ;;
    disable) verb="disabled" ;;
  esac
  printf '  %-9s %s\n' "$verb" "$2"
}

# un_manifest_hash FILE prints the hash that the setup recorded for FILE.
un_manifest_hash() { awk -F '\t' -v d="$1" '$1 == d {print $2}' "${STATE}/manifest.tsv" 2>/dev/null | tail -n 1; }

# un_unchanged FILE succeeds if FILE is a plain file with the recorded hash.
un_unchanged() {
  local recorded
  [ -f "$1" ] && [ ! -L "$1" ] || return 1
  recorded="$(un_manifest_hash "$1")"
  [ -n "$recorded" ] && [ "$recorded" = "$(sha_of "$1")" ]
}

un_is_gone() { printf '%s' "$UN_GONE" | grep -Fxq -- "$1"; }

# un_drop FILE LABEL removes FILE, or in a check, says that it would.
un_drop() {
  UN_GONE="${UN_GONE}$1
"
  UN_DIRS="${UN_DIRS}$(dirname "$1")
"
  [ "$UN_CHECK" -eq 1 ] || rm -f "$1"
  un_say remove "$(un_home "$1")${2:+ ($2)}"
}

# un_without FILE NAME... prints FILE with each marked block removed. A blank
# line that follows a block at the top of the file goes with it.
un_without() {
  local file="$1" name tmp
  shift
  tmp="$(mktemp)"
  cat "$file" >"$tmp"
  for name in "$@"; do
    awk -v begin="# >>> ${name} >>>" -v end="# <<< ${name} <<<" '
      $0 == begin { skip = 1; top = (NR == 1); next }
      skip && $0 == end { skip = 0; drop = top; top = 0; next }
      skip { next }
      drop && $0 ~ /^[ \t]*$/ { drop = 0; next }
      { drop = 0; print }' "$tmp" >"${tmp}.next"
    cat "${tmp}.next" >"$tmp"
    rm -f "${tmp}.next"
  done
  cat "$tmp"
  rm -f "$tmp"
}

# un_only_template FILE succeeds if FILE has no line besides blanks and the
# lines of the templates.
un_only_template() {
  local left
  left="$(grep -v '^[[:space:]]*$' "$1" | grep -vxF -f <(printf '%s\n' "$TEMPLATE_LINES") || true)"
  [ -z "$left" ]
}

# un_service_off stops the login service from starting again. It never stops a
# running server, because a stop closes every pane.
un_service_off() {
  if un_unchanged "$UN_UNIT"; then
    if [ "$UN_CHECK" -eq 1 ]; then
      un_say disable "the Herdr login service (a running server keeps running)"
    else
      if command -v systemctl >/dev/null 2>&1; then systemctl --user disable herdr.service >/dev/null 2>&1 || true; fi
      un_say disable "the Herdr login service (a running server keeps running)"
    fi
  fi
  if un_unchanged "$UN_PLIST"; then
    printf '  %-9s %s\n' note "The LaunchAgent stops loading at your next login. A running server keeps running."
  fi
}

# un_files removes each file of the manifest that no person changed.
un_files() {
  local file self="${HOME}/.local/bin/herdspace"
  if [ ! -f "${STATE}/manifest.tsv" ]; then
    printf '  There is no manifest of installed files, so no file is removed.\n'
    return 0
  fi
  while IFS=$'\t' read -r file _; do
    case "$file" in "$HOME"/*) ;; *) continue ;; esac
    { [ -e "$file" ] || [ -L "$file" ]; } || continue
    if un_unchanged "$file"; then
      # This command goes last, because the uninstall runs from it.
      [ "$file" = "$self" ] || un_drop "$file"
    else
      UN_KEPT="${UN_KEPT}${file}
"
      [ "$file" != "$self" ] || UN_SELF_KEEP=1
      printf '  %-9s %s (you changed it)\n' keep "$(un_home "$file")"
    fi
  done < <(awk -F '\t' 'NF >= 2 {last[$1] = $2} END {for (f in last) print f "\t" last[f]}' "${STATE}/manifest.tsv" | sort)
}

# un_blocks removes the marked blocks from the files of a person.
un_blocks() {
  local f file name had tmp ifs="$IFS"
  for f in $BLOCK_FILES; do
    file="${HOME}/${f}"
    { [ -f "$file" ] && [ ! -L "$file" ]; } || continue
    ! un_is_gone "$file" || continue
    had=""
    IFS='|'
    for name in $BLOCK_NAMES; do
      if grep -qxF -- "# >>> ${name} >>>" "$file"; then had="${had}${had:+|}${name}"; fi
    done
    [ -n "$had" ] || { IFS="$ifs"; continue; }
    # shellcheck disable=SC2086 # One word for each block name.
    set -- $had
    IFS="$ifs"
    tmp="$(mktemp)"
    un_without "$file" "$@" >"$tmp"
    if [ ! -s "$tmp" ] || un_only_template "$tmp"; then
      un_drop "$file" "it has only the blocks of herdspace"
    else
      [ "$UN_CHECK" -eq 1 ] || cat "$tmp" >"$file"
      un_say edit "$(un_home "$file"): the herdspace blocks go, your lines stay"
    fi
    rm -f "$tmp"
  done
  if [ -f "${HOME}/.zshenv" ] && grep -qxF '# >>> herdspace bash env >>>' "${HOME}/.zshenv"; then
    printf '  %-9s %s\n' keep "$(un_home "${HOME}/.zshenv"): the block with the exports that the setup moved from your bash files"
  fi
}

# un_mission_control gives the Ctrl arrow shortcuts back to Mission Control, if
# the setup turned them off. The file done/mission-control records that.
un_mission_control() {
  local mark="${STATE}/done/mission-control" pair
  local activate="${ACTIVATE_SETTINGS:-/System/Library/PrivateFrameworks/SystemAdministration.framework/Resources/activateSettings}"
  [ -f "$mark" ] || return 0
  if [ "$UN_CHECK" -eq 0 ]; then
    for pair in "32 126" "33 125" "79 123" "81 124"; do
      # shellcheck disable=SC2086 # One word for the shortcut and one for the key.
      set -- $pair
      defaults write com.apple.symbolichotkeys AppleSymbolicHotKeys -dict-add "$1" \
        "<dict><key>enabled</key><true/><key>value</key><dict><key>type</key><string>standard</string><key>parameters</key><array><integer>65535</integer><integer>$2</integer><integer>8650752</integer></array></dict></dict>"
    done
    [ ! -x "$activate" ] || "$activate" -u >/dev/null 2>&1 || true
    rm -f "$mark"
  fi
  un_say restore "the Ctrl arrow shortcuts of Mission Control (log out and in if a key does not work)"
}

# un_generated removes what herdspace makes by itself: the plugins and the data
# of its Neovim, and two files that Neovim writes. The folder with the Neovim
# files stays if it holds a file of yours.
un_generated() {
  local nvim="${HOME}/.config/herdspace-nvim" d f other=0
  if [ -d "$nvim" ]; then
    while IFS= read -r f; do
      case "$f" in */lazy-lock.json | */lazyvim.json) continue ;; esac
      un_is_gone "$f" || other=1
    done < <(find "$nvim" -type f -o -type l 2>/dev/null)
    if [ "$other" -eq 0 ]; then
      for f in "$nvim/lazy-lock.json" "$nvim/lazyvim.json"; do
        [ ! -f "$f" ] || un_drop "$f"
      done
    fi
  fi
  for d in "${HOME}/.local/share/herdspace-nvim" "${HOME}/.local/state/herdspace-nvim" "${XDG_CACHE_HOME:-$HOME/.cache}/herdspace-nvim"; do
    [ -d "$d" ] || continue
    [ "$UN_CHECK" -eq 1 ] || rm -rf "$d"
    un_say remove "$(un_home "$d")/ (the data of the herdspace Neovim)"
  done
}

# un_prune removes each empty folder that held a removed file, up to your home
# folder and the folders that other programs share.
un_prune() {
  local dir stop
  [ "$UN_CHECK" -eq 0 ] || return 0
  while IFS= read -r dir; do
    [ -n "$dir" ] || continue
    while [ "$dir" != "$HOME" ] && [ "$dir" != "/" ] && [ -d "$dir" ]; do
      for stop in $SHARED_DIRS; do
        [ "$dir" != "${HOME}/${stop//_/ }" ] || break 2
      done
      rmdir "$dir" 2>/dev/null || break
      dir="$(dirname "$dir")"
    done
  done <<<"$UN_DIRS"
}

# un_state removes the choices, the cache, the state, and then this command.
un_state() {
  local conf="${HOME}/.config/herdspace" self="${HOME}/.local/bin/herdspace"
  if [ -d "$conf" ]; then
    if [ "$UN_CHECK" -eq 0 ]; then
      rm -f "$conf/keys" "$conf/look"
      if rmdir "$conf" 2>/dev/null; then
        un_say remove "$(un_home "$conf")/"
      else
        printf '  %-9s %s\n' keep "$(un_home "$conf")/ (it holds a backup or a file of yours)"
      fi
    else
      un_say remove "$(un_home "$conf")/ (your choice of keys and look, and the folder if it is empty)"
    fi
  fi
  if [ -d "$CACHE" ]; then
    [ "$UN_CHECK" -eq 1 ] || rm -rf "$CACHE"
    un_say remove "$(un_home "$CACHE")/"
  fi
  if [ -d "$STATE" ]; then
    [ "$UN_CHECK" -eq 1 ] || rm -rf "$STATE"
    un_say remove "$(un_home "$STATE")/ (the manifest, the saved setup, and the downloaded releases)"
  fi
  if [ -e "$self" ] && [ "$UN_SELF_KEEP" -eq 0 ]; then
    [ "$UN_CHECK" -eq 1 ] || rm -f "$self"
    un_say remove "$(un_home "$self") (this command)"
  fi
}

# un_stays says what the uninstall leaves, and how to remove it by hand.
un_stays() {
  printf '\n  What stays:\n'
  printf '    Your projects, your Herdr sessions, and each file of yours. A running Herdr server keeps running.\n'
  printf '    Herdr, and the tools of the setup (zsh, Neovim, lazygit, eza, zoxide, fzf, bat, fd, delta).\n'
  if [ "$(uname -s)" = "Darwin" ]; then
    printf '      Remove a package by hand: brew uninstall <name>. For Ghostty: brew uninstall --cask ghostty\n'
  else
    printf '      Remove a package by hand: sudo apt-get remove <name>. For a tool in ~/.local/bin: rm ~/.local/bin/<name>\n'
    printf '      Remove the Neovim of the setup: rm -r ~/.local/opt/neovim. Turn off the linger of the login service: loginctl disable-linger\n'
  fi
  printf '    Your login shell. To go back to bash: chsh -s /bin/bash\n'
  printf '    Oh My Zsh and its plugins. Remove them by hand: rm -rf ~/.oh-my-zsh\n'
  printf '    The backups of the setup, named *.bak-<date>. Delete them when you do not need them.\n'
  printf '    The integrations and the plugin of Herdr. See: herdr integration --help and herdr plugin --help\n'
}

cmd_uninstall() {
  local a answer="" yes=0 file
  UN_CHECK=0
  for a in "$@"; do
    case "$a" in
      --check) UN_CHECK=1 ;;
      --yes | -y) yes=1 ;;
      *) printf "herdspace: 'uninstall' does not know '%s'. Use --check or --yes.\n" "$a" >&2; exit 2 ;;
    esac
  done
  [ -d "$STATE" ] || [ -e "${HOME}/.local/bin/herdspace" ] || die "herdspace is not set up here. ${STATE} does not exist."
  if [ "$UN_CHECK" -eq 1 ]; then
    printf '  This is a check. Nothing changes.\n\n'
  else
    printf '  This removes the files that the herdspace setup wrote, and each marked block.\n'
    printf '  A file that you changed stays. To see the list first, run: herdspace uninstall --check\n'
    if [ "$yes" -eq 0 ]; then
      [ -t 0 ] || die "There is no terminal to ask. Run: herdspace uninstall --yes"
      printf '\n  Uninstall herdspace? [y/N] '
      IFS= read -r answer || answer=""
      case "$answer" in y | Y | yes) ;; *) printf '  Nothing changed.\n'; return 0 ;; esac
    fi
    printf '\n'
  fi
  un_service_off
  un_files
  un_blocks
  un_mission_control
  un_generated
  un_prune
  [ "$UN_CHECK" -eq 1 ] || ! command -v systemctl >/dev/null 2>&1 || systemctl --user daemon-reload >/dev/null 2>&1 || true
  un_state
  un_stays
  if [ "$UN_CHECK" -eq 1 ]; then
    printf '\n  Nothing changed. To uninstall, run: herdspace uninstall\n'
  elif [ -n "$UN_KEPT" ]; then
    printf '\n  Done. These files stay, because you changed them:\n'
    printf '%s' "$UN_KEPT" | while IFS= read -r file; do [ -z "$file" ] || printf '    %s\n' "$(un_home "$file")"; done
  else
    printf '\n  Done. herdspace is removed.\n'
  fi
}

case "${1:-help}" in
  update) shift; cmd_update "$@" ;;
  keys) shift; cmd_keys "$@" ;;
  uninstall) shift; cmd_uninstall "$@"; exit $? ;;
  version | --version | -V) cmd_version ;;
  notice) cmd_notice ;;
  refresh) cmd_refresh ;;
  help | --help | -h) usage ;;
  *)
    # As git and GNU tools do: the error, a suggestion, and where the help is.
    printf "herdspace: '%s' is not a herdspace command.\n" "$1" >&2
    case "${1#"${1%%[!-]*}"}" in
      update | version | help | keys | uninstall) printf "Did you mean 'herdspace %s'?\n" "${1#"${1%%[!-]*}"}" >&2 ;;
    esac
    printf "Run 'herdspace help' for the usage.\n" >&2
    exit 2
    ;;
esac
