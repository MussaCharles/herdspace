#!/usr/bin/env bash
# herdspace shows the installed version, says when a new release exists, and
# updates the setup with the role and the options of the last setup.
#
# Usage: herdspace update [setup options]  Update to the latest release.
#        herdspace update --force          Run the setup again on the latest release.
#        herdspace update --version TAG    Install the release TAG, also an older one.
#        herdspace --version               The installed and the latest version.
#        herdspace version                 The same as --version.
#        herdspace keys [normal|herdr]     Show or change the Ghostty keys (client).
#        herdspace editor [reader|normal]  Show or change the Neovim defaults (server).
#        herdspace uninstall --check       List what an uninstall changes. Change nothing.
#        herdspace uninstall [--yes]       Remove what the setup wrote. Ask once first.
#        herdspace help                    This help.
#
# The herdspace shell runs "herdspace notice" when it starts: at most once a
# day, it prints one line when a new release exists. It asks GitHub in the
# background, so the shell does not wait. HERDSPACE_UPDATE_CHECK=0 turns it off.
set -uo pipefail
REPO="${HS_REPO:-MussaCharles/herdspace}"
STATE="${HOME}/.local/share/herdspace"
CACHE="${XDG_CACHE_HOME:-$HOME/.cache}/herdspace"

usage() { sed -n '2,/^[^#]/{/^#/p;}' "$0" | sed 's/^# \{0,1\}//'; }

# herdspace_lib prints the folder of the modules of herdspace: lib/herdspace,
# next to the bin folder of this file, also when herdspace is a symbolic link.
# The setup installs the modules to ~/.local/lib/herdspace.
herdspace_lib() {
  local self="${BASH_SOURCE[0]}" dir
  while [ -L "$self" ]; do
    dir="$(cd "$(dirname "$self")" && pwd -P)"
    self="$(readlink "$self")"
    case "$self" in /*) ;; *) self="${dir}/${self}" ;; esac
  done
  dir="$(cd "$(dirname "$self")" && pwd -P)"
  printf '%s/../lib/herdspace' "$dir"
}
HERDSPACE_LIB="$(herdspace_lib)"
[ -f "${HERDSPACE_LIB}/common.sh" ] || { printf '  [err]  herdspace cannot find its modules in %s. Run the setup again.\n' "$HERDSPACE_LIB" >&2; exit 1; }

# shellcheck source-path=SCRIPTDIR/..
# shellcheck source=lib/herdspace/common.sh
source "${HERDSPACE_LIB}/common.sh"
# shellcheck source=lib/herdspace/version.sh
source "${HERDSPACE_LIB}/version.sh"
# shellcheck source=lib/herdspace/update.sh
source "${HERDSPACE_LIB}/update.sh"
# shellcheck source=lib/herdspace/editor.sh
source "${HERDSPACE_LIB}/editor.sh"
# shellcheck source=lib/herdspace/keys.sh
source "${HERDSPACE_LIB}/keys.sh"
# shellcheck source=lib/herdspace/uninstall.sh
source "${HERDSPACE_LIB}/uninstall.sh"

case "${1:-help}" in
  update) shift; cmd_update "$@" ;;
  keys) shift; cmd_keys "$@" ;;
  editor) shift; cmd_editor "$@" ;;
  uninstall) shift; cmd_uninstall "$@"; exit $? ;;
  version | --version | -V) cmd_version ;;
  notice) cmd_notice ;;
  refresh) cmd_refresh ;;
  help | --help | -h) usage ;;
  *)
    # As git and GNU tools do: the error, a suggestion, and where the help is.
    printf "herdspace: '%s' is not a herdspace command.\n" "$1" >&2
    case "${1#"${1%%[!-]*}"}" in
      update | version | help | keys | editor | uninstall) printf "Did you mean 'herdspace %s'?\n" "${1#"${1%%[!-]*}"}" >&2 ;;
    esac
    printf "Run 'herdspace help' for the usage.\n" >&2
    exit 2
    ;;
esac
