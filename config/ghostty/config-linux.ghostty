# Ghostty configuration from herdspace, for Linux. The setup copies each section
# into a marked block at the top of ~/.config/ghostty/config.ghostty, and keeps
# the other lines of that file.

# herdspace appearance: start. --keep-terminal-look leaves this section out.
background = #1b1313
background-opacity = 0.905
window-width = 120
window-height = 34
# herdspace appearance: end

# herdspace keys: start. --keep-terminal-keys leaves this section out.
# These keys reach Herdr and Neovim. Ghostty cannot limit a key to one
# program, so outside Herdr they do nothing. Use the replacement keys below there.
keybind = ctrl+shift+t=unbind
keybind = ctrl+shift+w=unbind
keybind = ctrl+shift+f=unbind
keybind = ctrl+shift+e=unbind
keybind = ctrl+shift+p=unbind
# The replacement keys: the same keys with Alt.
keybind = ctrl+alt+shift+t=new_tab
keybind = ctrl+alt+shift+w=close_surface
keybind = ctrl+alt+shift+f=start_search
keybind = ctrl+alt+shift+e=new_split:down
keybind = ctrl+alt+shift+p=toggle_command_palette
# herdspace keys: end

# herdspace ssh: start. The setup always adds this section.
# When you type ssh, Ghostty sends TERM=xterm-256color, so that a server
# without the xterm-ghostty terminal description can run clear and other
# commands. It writes nothing on the server. The features that this line does
# not name keep their default.
shell-integration-features = ssh-env
# herdspace ssh: end
