# A throwaway Linux server that runs real systemd, to test the login service.
FROM ubuntu:24.04
# APT_MIRROR_UBUNTU and APT_MIRROR_DEBIAN put another mirror in front of the
# default one. tests/lib-docker.sh passes them. With none, nothing changes.
ARG APT_MIRROR_UBUNTU=""
ARG APT_MIRROR_DEBIAN=""
COPY tests/apt-mirror.sh /usr/local/sbin/apt-mirror.sh
# The last step keeps apt downloads, so that tests/lib-docker.sh can share them.
RUN APT_MIRROR_UBUNTU="$APT_MIRROR_UBUNTU" APT_MIRROR_DEBIAN="$APT_MIRROR_DEBIAN" /usr/local/sbin/apt-mirror.sh \
  && apt-get update -qq && apt-get install -y -qq --no-install-recommends \
    systemd systemd-sysv dbus dbus-user-session libpam-systemd sudo ca-certificates procps >/dev/null \
  && useradd -m -s /bin/bash tester \
  && echo 'tester ALL=(ALL) NOPASSWD:ALL' >/etc/sudoers.d/tester \
  && rm -f /etc/apt/apt.conf.d/docker-clean
COPY --chown=tester:tester . /home/tester/repo
STOPSIGNAL SIGRTMIN+3
CMD ["/sbin/init"]
